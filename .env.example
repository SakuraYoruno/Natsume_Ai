# Natsume AI environment template (no real secrets).
# If required keys are empty, the system should enter cold-start degraded mode.

APP_ENV=dev
NATSUME_RUNTIME_MODE=cold_start

# Host service
HOST_BIND=127.0.0.1
HOST_PORT=8080

# External model providers (leave empty in cold-start mode)
OPENAI_API_KEY=
DIFY_API_KEY=

# Datastores
SQLITE_PATH=./data/audit.sqlite3
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Edge runtime
EDGE_RPC_BIND=127.0.0.1
EDGE_RPC_PORT=8090

# Degrade policy
ALLOW_EXECUTION_WITHOUT_TOKEN=false
FORCE_REASON_CODE_ON_REJECT=true

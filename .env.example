# Natsume AI runtime template (no real secrets).
# This file only contains variables read by current runtime loaders.
# Keep secret values empty and use *_REF when integrating with secret store.

# Shared runtime environment
NATSUME_ENV=dev

# Host runtime
HOST_LLM_PROVIDER=openai
HOST_LLM_TIMEOUT_MS=15000
HOST_LLM_MAX_RETRIES=1
HOST_COLD_START_ALLOWED=true
HOST_ENABLE_RETRIEVAL=true
HOST_ENABLE_VISION=true
HOST_ENABLE_EDGE_RPC=true
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# OPENAI_API_KEY_REF=sec://openai/natsu-node-01
# DEEPSEEK_API_KEY_REF=sec://deepseek/natsu-node-04
# GEMINI_API_KEY_REF=sec://gemini/natsu-node-06
# DEEPSEEK_API_KEY_REF=sec://deepseek/natsu-node-09

# Edge runtime
EDGE_RPC_HOST=127.0.0.1
EDGE_RPC_PORT=17800
EDGE_ALLOW_INSECURE_AUTH=true
EDGE_RPC_GATEWAY_ENABLED=true
EDGE_ASR_ENABLED=true
EDGE_TTS_ENABLED=true
EDGE_BARGE_IN_ENABLED=true
EDGE_FALLBACK_LLM_ENABLED=false
EDGE_RESOURCE_GATE_ENABLED=true
EDGE_MAX_VRAM_MB=4096
EDGE_MAX_QUEUE_LENGTH=8
EDGE_HMAC_SHARED_KEY=
# EDGE_HMAC_SHARED_KEY_REF=sec://edge/natsu-node-06

# Neo4j dependency
BOND_NEO4J_ENABLED=true
BOND_NEO4J_URI=bolt://127.0.0.1:7687
BOND_NEO4J_DATABASE=neo4j
BOND_NEO4J_AUTH_REF=sec://neo4j/local-default
BOND_NEO4J_POOL_SIZE=50
BOND_NEO4J_TLS_ENABLED=false

# Chroma dependency
CHROMA_ENABLED=true
CHROMA_ENDPOINT=http://127.0.0.1:8000
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
CHROMA_DEFAULT_COLLECTION=episodic
CHROMA_COLLECTION_PROFILES_JSON={"episodic":16}

# Embedding runtime routes
RETR_EMBED_ENABLED=true
RETR_EMBED_DEFAULT_ROUTE=host_default
RETR_EMBED_ROUTES_JSON={"host_default":{"provider":"builtin_hash","model_id":"hash-embed-v1","dim":16,"timeout_ms":500,"node_selector":"default,natsu-node-01"},"gpu_route":{"provider":"openai","model_id":"text-embedding-3-large","dim":3072,"timeout_ms":900,"node_selector":"natsu-node-04,natsu-node-09"}}

# Reranker runtime routes
RETR_RERANK_ENABLED=true
RETR_RERANK_DEFAULT_ROUTE=host_default
RETR_RERANK_ROUTES_JSON={"host_default":{"provider":"heuristic","model_id":"heuristic-rerank-v1","top_k":5,"timeout_ms":500,"node_selector":"default,natsu-node-01"},"gpu_route":{"provider":"cross_encoder","model_id":"bge-reranker-large","top_k":3,"timeout_ms":800,"node_selector":"natsu-node-04,natsu-node-09"}}

# Multi-route recall fusion
RETR_RECALL_ENABLED=true
RETR_RECALL_DEFAULT_ROUTE=episodic_route
RETR_RECALL_ROUTES_JSON={"episodic_route":{"collection":"episodic","top_k":8,"score_weight":1.0,"node_selector":"default,natsu-node-01"},"canon_route":{"collection":"canon","top_k":4,"score_weight":0.75,"node_selector":"default,natsu-node-01"}}

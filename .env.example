# Natsume AI 运行时配置模板（含详细中文注释）。
# 读取优先级：
#   1) 根目录 .env（本地真实配置）
#   2) 根目录 .env.example（本文件，示例/降级回退）
#
# 安全要求：
# - 所有真实密钥必须只放在本地 .env 或本地 secret store。
# - 本文件必须保持可提交状态，禁止写入真实密钥。

### Environment
# 主环境标识；可选 dev/test/prod，影响鉴权策略、冷启动策略和部分默认开关。
Natsume_ENV=dev
# 兼容历史拼写的环境标识；建议与 Natsume_ENV 保持一致，避免旧模块读取到不同值。
Nastume_ENV=dev

### Host app
# Host HTTP 服务监听地址；本机开发通常使用 127.0.0.1，对外访问可改为 0.0.0.0。
HOST_APP_HOST=127.0.0.1
# Host HTTP 服务端口；默认 18080，需确保未被占用。
HOST_APP_PORT=18080
# Host 日志级别；常用 DEBUG/INFO/WARNING/ERROR。
HOST_APP_LOG_LEVEL=INFO

### Host LLM and feature gates
# Host 主 LLM 提供商；可选 openai/gemini/deepseek/mock/disabled。
HOST_LLM_PROVIDER=openai
# Host 调用 LLM 的单次超时时间（毫秒）。
HOST_LLM_TIMEOUT_MS=15000
# Host 调用 LLM 的最大重试次数；0 表示不重试。
HOST_LLM_MAX_RETRIES=1
# 冷启动是否允许在缺失可用 LLM 密钥时继续启动（通常 dev=true，prod=false）。
HOST_COLD_START_ALLOWED=true
# 是否启用检索链路（Recall/Embedding/Reranker）。
HOST_ENABLE_RETRIEVAL=true
# 是否启用视觉相关能力（OCR/视觉识别等）。
HOST_ENABLE_VISION=true
# 是否启用 Host 与 Edge 的 RPC 交互能力。
HOST_ENABLE_EDGE_RPC=true

### Host rate limit
# Host 限流后端；可选 memory/sqlite/redis。
HOST_RATE_LIMIT_BACKEND=memory
# 限流时间窗口（毫秒）；在该窗口内统计请求数。
HOST_RATE_LIMIT_WINDOW_MS=60000
# 限流窗口内最大请求数；超过后按策略拒绝或降级。
HOST_RATE_LIMIT_MAX_REQUESTS=30
# 当限流后端为 sqlite 时使用的数据库路径；为空表示使用默认路径。
HOST_RATE_LIMIT_SQLITE_DB_PATH=
# 当限流后端为 redis 时的连接地址。
HOST_RATE_LIMIT_REDIS_URL=redis://127.0.0.1:6379/0
# Redis 限流键前缀；用于隔离不同环境/项目的键空间。
HOST_RATE_LIMIT_REDIS_KEY_PREFIX=natsume:rate_limit:
# Redis 请求超时时间（毫秒）；过小可能导致误判不可用。
HOST_RATE_LIMIT_REDIS_TIMEOUT_MS=1000

### API keys (keep empty in template)
# OpenAI API Key；模板中必须留空，运行时在本地 .env 填写。
OPENAI_API_KEY=
# Gemini API Key；模板中必须留空，运行时在本地 .env 填写。
GEMINI_API_KEY=
# DeepSeek API Key；模板中必须留空，运行时在本地 .env 填写。
DEEPSEEK_API_KEY=
# LangSmith API Key；用于链路追踪上报，模板中必须留空。
LANGSMITH_API_KEY=

### API key refs (non-secret identifiers)
# OpenAI 密钥引用标识（非密钥）；用于从 secret store 解析真实密钥。
OPENAI_API_KEY_REF=sec://llm/openai/default
# Gemini 密钥引用标识（非密钥）；用于从 secret store 解析真实密钥。
GEMINI_API_KEY_REF=sec://llm/gemini/default
# DeepSeek 密钥引用标识（非密钥）；用于从 secret store 解析真实密钥。
DEEPSEEK_API_KEY_REF=sec://llm/deepseek/default

### Host runtime
# Host 审计账本数据库路径（SQLite）；建议放在本地磁盘。
Natsume_AUDIT_DB=host_brain/data/audit.sqlite3
# CORS 允许来源；可填逗号分隔域名列表，留空表示使用服务默认策略。
Natsume_CORS_ORIGINS=
# World Canon 根目录路径；用于加载世界观常识与规则素材。
Natsume_WORLD_CANON_ROOT=host_brain/canon/world
# 是否在控制台启用运行时监控输出；true 会增加控制台日志噪声。
Natsume_RUNTIME_MONITOR_CONSOLE=false
# 可观测模式开关；通常 dev 使用调试模式，prod 使用生产模式。
OBS_MODE=prod

### LangSmith (optional)
# 是否启用 LangSmith 链路追踪。
LANGSMITH_TRACING=false
# LangSmith 项目名；启用追踪时建议设置，便于多项目隔离。
LANGSMITH_PROJECT=
# LangSmith API 端点；默认官方服务地址。
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

### Edge RPC
# Edge RPC 网关监听地址；本机开发通常为 127.0.0.1。
EDGE_RPC_HOST=127.0.0.1
# Edge RPC 网关监听端口；默认 17800。
EDGE_RPC_PORT=17800
# 是否允许不安全鉴权；仅建议 dev/test 使用，prod 应设为 false。
EDGE_ALLOW_INSECURE_AUTH=true
# RPC 请求时间戳鉴权窗口（毫秒）；超出窗口会被拒绝。
EDGE_RPC_AUTH_WINDOW_MS=15000
# RPC nonce 去重时间窗口（毫秒）；用于重放攻击防护。
EDGE_RPC_NONCE_WINDOW_MS=120000
# 是否启用 Edge RPC 网关主开关；关闭后相关语音链路将不可用或降级。
EDGE_RPC_GATEWAY_ENABLED=true

### Edge feature gates
# 是否启用 Edge ASR（语音识别）能力。
EDGE_ASR_ENABLED=true
# 是否启用 Edge TTS（语音合成）能力。
EDGE_TTS_ENABLED=true
# 是否启用打断（barge-in）能力；通常依赖 TTS 开启。
EDGE_BARGE_IN_ENABLED=true
# 是否启用 Edge 侧兜底小模型能力。
EDGE_FALLBACK_LLM_ENABLED=false
# 是否启用 Edge 资源门控（显存/队列保护）。
EDGE_RESOURCE_GATE_ENABLED=true
# Edge 可用显存上限（MB）；超过后会触发降级或抢占策略。
EDGE_MAX_VRAM_MB=4096
# Edge 请求队列最大长度；超过后新请求可能被拒绝或降级。
EDGE_MAX_QUEUE_LENGTH=8
# 资源门控软阈值比例（0~1）；达到该比例开始趋向保守调度。
EDGE_RESOURCE_GATE_VRAM_SOFT_LIMIT_RATIO=0.9
# 资源门控允许的兜底队列深度；用于保护主链路吞吐。
EDGE_RESOURCE_GATE_MAX_FALLBACK_QUEUE_DEPTH=1

### Edge auth secret (keep empty in template)
# Edge RPC HMAC 共享密钥；模板中必须留空，prod 场景强烈建议配置。
EDGE_HMAC_SHARED_KEY=
# Edge HMAC 密钥引用标识（非密钥）；用于从 secret store 解析真实密钥。
EDGE_HMAC_SHARED_KEY_REF=sec://edge/hmac/default

### Edge ASR
# ASR 模型标识或本地模型目录；例如 large-v3。
EDGE_ASR_MODEL_SIZE=large-v3
# ASR 推理设备；可选 cuda/cpu。
EDGE_ASR_DEVICE=cuda
# ASR 计算精度；常见 float16/int8/float32。
EDGE_ASR_COMPUTE_TYPE=float16
# ASR beam size；越大通常精度更高但速度更慢。
EDGE_ASR_BEAM_SIZE=5
# ASR 音频采样率（Hz）；需与采集链路一致。
EDGE_ASR_SAMPLE_RATE=16000
# ASR 音频通道数；单声道通常设为 1。
EDGE_ASR_CHANNELS=1
# ASR 分块时长（秒）；越小延迟更低但开销更高。
EDGE_ASR_CHUNK_DURATION_S=0.5
# VAD 阈值；越高越保守，越低越容易误触发语音段。
EDGE_ASR_VAD_THRESHOLD=0.5
# 判定静音结束所需最小时长（秒）。
EDGE_ASR_SILENCE_DURATION_S=0.8
# 语音片段最小时长（秒）；小于该值可能被过滤。
EDGE_ASR_MIN_SPEECH_DURATION_S=0.3
# 单段语音最长期限（秒）；超过后会被切段或强制结束。
EDGE_ASR_MAX_SPEECH_DURATION_S=30.0
# ASR 识别语言；如 ja/zh/en，可留空走自动识别策略（若模型支持）。
EDGE_ASR_LANGUAGE=ja
# ASR 初始提示词；用于提升特定术语识别，可留空。
EDGE_ASR_INITIAL_PROMPT=
# 指定 GPU 设备索引；留空表示使用默认设备。
EDGE_ASR_DEVICE_INDEX=
# ASR 自动恢复最大尝试次数。
EDGE_ASR_RECOVERY_MAX_ATTEMPTS=5
# ASR 自动恢复基础退避时间（秒）。
EDGE_ASR_RECOVERY_BASE_DELAY_S=1.0
# ASR 自动恢复最大退避时间（秒）。
EDGE_ASR_RECOVERY_MAX_DELAY_S=8.0
# 是否启用 ASR 自动恢复。
EDGE_ASR_RECOVERY_AUTO=true
# 自动恢复时是否尝试切换候选设备（例如多 GPU 场景）。
EDGE_ASR_RECOVERY_TRY_ALTERNATE_DEVICES=true

### Edge TTS
# TTS 模型根路径；应包含推理所需权重与配置文件。
EDGE_TTS_MODEL_PATH=models/gpt_sovits
# TTS 推理设备；可选 cuda/cpu。
EDGE_TTS_DEVICE=cuda
# TTS 输出采样率（Hz）；需与播放链路兼容。
EDGE_TTS_SAMPLE_RATE=32000
# 单次 TTS 最大文本长度；超出需上层切分。
EDGE_TTS_MAX_TEXT_LENGTH=500
# TTS 单次合成超时时间（秒）。
EDGE_TTS_SYNTH_TIMEOUT_S=30.0
# TTS 参考音频路径（可选）；用于音色/风格迁移。
EDGE_TTS_REF_AUDIO_PATH=
# TTS 参考文本（可选）；与参考音频配套使用。
EDGE_TTS_REF_TEXT=
# TTS 目标语言；如 ja/zh/en，具体受模型能力限制。
EDGE_TTS_LANGUAGE=ja
# 播放设备索引；留空表示系统默认输出设备。
EDGE_TTS_PLAYBACK_DEVICE_INDEX=
# Edge 兜底小模型 ID；仅在 EDGE_FALLBACK_LLM_ENABLED=true 时生效。
EDGE_FALLBACK_LLM_MODEL_ID=ollama:3b-q4

### Edge VTS
# VTube Studio API 主机地址；本机一般为 localhost。
EDGE_VTS_HOST=localhost
# VTube Studio API 端口；默认 8001。
EDGE_VTS_PORT=8001
# VTube Studio 插件名称；用于鉴权弹窗和会话识别。
EDGE_VTS_PLUGIN_NAME=NatsumeAi
# VTube Studio 插件开发者名称；用于鉴权弹窗展示。
EDGE_VTS_PLUGIN_DEVELOPER=Natsume
# VTube Studio token 保存路径；首次授权后用于复用会话。
EDGE_VTS_TOKEN_PATH=.vts_token
# 调用 VTS API 的请求超时时间（秒）。
EDGE_VTS_API_TIMEOUT_S=5.0
# VTS 断线重连最大尝试次数。
EDGE_VTS_RECONNECT_MAX_ATTEMPTS=10
# VTS 重连基础退避时间（秒）。
EDGE_VTS_RECONNECT_BASE_DELAY_S=1.0
# VTS 重连最大退避时间（秒）。
EDGE_VTS_RECONNECT_MAX_DELAY_S=16.0
# 是否启用 VTS 自动重连。
EDGE_VTS_RECONNECT_AUTO=true
# 是否在启动 Edge 时自动尝试拉起 VTube Studio（Steam 协议）。
EDGE_VTS_AUTOSTART=false
# VTube Studio 的 Steam App ID。
EDGE_VTS_STEAM_APP_ID=1325860
# 自动拉起后等待 VTS 端口就绪的超时时间（秒）。
EDGE_VTS_AUTOSTART_WAIT_SECONDS=35
# VTS API 端口别名变量；供部分旧逻辑或脚本兼容读取。
VTS_API_PORT=8001

### Edge service ports
# Edge ASR 子服务健康探测端口。
EDGE_ASR_PORT=17801
# Edge TTS 子服务健康探测端口。
EDGE_TTS_PORT=17802

### Edge event reporting
# Edge 事件离线缓存最大条数；超出后按策略丢弃最旧事件。
EDGE_EVENT_REPORT_MAX_CACHE_EVENTS=1000
# Edge 事件离线缓存最大字节数；用于限制本地缓存体积。
EDGE_EVENT_REPORT_MAX_CACHE_BYTES=10485760
# 事件上报最大重试次数。
EDGE_EVENT_REPORT_MAX_RETRY_ATTEMPTS=5
# 事件上报重试基础退避时间（秒）。
EDGE_EVENT_REPORT_BASE_RETRY_DELAY_S=1.0
# 事件上报重试最大退避时间（秒）。
EDGE_EVENT_REPORT_MAX_RETRY_DELAY_S=30.0

### Neo4j (Bond)
# 是否启用 Neo4j 依赖；关闭后 Bond 图能力会降级或不可用。
BOND_NEO4J_ENABLED=true
# Neo4j 连接 URI；本地默认 bolt://127.0.0.1:7687。
BOND_NEO4J_URI=bolt://127.0.0.1:7687
# Neo4j 数据库名；Neo4j 5+ 可多数据库。
BOND_NEO4J_DATABASE=neo4j
# Neo4j 凭据引用标识（非密钥）；映射到 secret store 中 user:password 或 password。
BOND_NEO4J_AUTH_REF=sec://neo4j/local-default
# Neo4j 连接池大小；并发高时可适当提高。
BOND_NEO4J_POOL_SIZE=50
# 是否启用 Neo4j TLS；公网或跨机访问建议开启并配置证书。
BOND_NEO4J_TLS_ENABLED=false

### Chroma (Memory)
# 是否启用 Chroma 向量库依赖。
CHROMA_ENABLED=true
# Chroma HTTP 端点地址。
CHROMA_ENDPOINT=http://127.0.0.1:8000
# Chroma tenant 名称；用于租户级隔离。
CHROMA_TENANT=default_tenant
# Chroma database 名称；用于库级隔离。
CHROMA_DATABASE=default_database
# 默认向量集合名称；未指定集合时使用该值。
CHROMA_DEFAULT_COLLECTION=episodic
# 各集合向量维度配置（JSON 对象）；格式示例 {"episodic":1024,"canon":1024}。
# Qwen3-Embedding-0.6B 输出维度为 1024，切换模型时需同步修改此处并重建 collection。
CHROMA_COLLECTION_PROFILES_JSON={"episodic":1024,"canon":1024}

### Retrieval - Embedding
# 是否启用 Embedding 能力。
RETR_EMBED_ENABLED=true
# Embedding 默认路由 ID；需能在 RETR_EMBED_ROUTES_JSON 中找到。
RETR_EMBED_DEFAULT_ROUTE=host_default
# Embedding 路由表（JSON 对象）；每条路由包含 provider/model_id/dim/timeout_ms/node_selector。
# Qwen3-Embedding-0.6B：中文语义质量高，dim=1024，需 GPU 推理（RTX 5080 16G 约 10-30ms/条）。
# 本地模型路径示例：models/Qwen3-Embedding-0.6B（从 HuggingFace 下载后放到 models/ 目录）。
RETR_EMBED_ROUTES_JSON={"host_default":{"provider":"sentence_transformers","model_id":"Qwen/Qwen3-Embedding-0.6B","dim":1024,"timeout_ms":20000,"node_selector":"default,natsu-node-01"}}
# Embedding 推理设备（部分 provider 使用）；如 cpu/cuda。
RETR_EMBED_DEVICE=cuda
# Embedding 兼容默认 provider（当未走路由 JSON 或回退路径时使用）。
RETR_EMBED_PROVIDER=builtin_hash
# Embedding 兼容默认模型 ID（回退路径使用）。
RETR_EMBED_MODEL_ID=hash-embed-v1
# Embedding 兼容默认向量维度（回退路径使用）。
RETR_EMBED_DIM=1024
# Embedding 兼容默认超时时间（毫秒，回退路径使用）。
RETR_EMBED_TIMEOUT_MS=500
# Embedding 兼容默认节点选择器（回退路径使用）。
RETR_EMBED_NODE_SELECTOR=default

### Retrieval - Reranker
# 是否启用 Reranker 能力。
RETR_RERANK_ENABLED=true
# Reranker 默认路由 ID；需能在 RETR_RERANK_ROUTES_JSON 中找到。
RETR_RERANK_DEFAULT_ROUTE=host_default
# Reranker 路由表（JSON 对象）；每条路由包含 provider/model_id/top_k/timeout_ms/node_selector。
# Qwen3-Reranker-0.6B：生成式重排，中文语义质量高，需使用 qwen3_reranker provider（非 cross_encoder）。
# RTX 5080 16G 约 50-200ms/批（20条候选），timeout_ms 建议 30000。
# 本地模型路径示例：models/Qwen3-Reranker-0.6B（从 HuggingFace 下载后放到 models/ 目录）。
RETR_RERANK_ROUTES_JSON={"host_default":{"provider":"qwen3_reranker","model_id":"Qwen/Qwen3-Reranker-0.6B","top_k":5,"timeout_ms":30000,"node_selector":"default,natsu-node-01"}}
# Reranker 推理设备（部分 provider 使用）；如 cpu/cuda。
RETR_RERANK_DEVICE=cuda
# Reranker 兼容默认 provider（回退路径使用）。
RETR_RERANK_PROVIDER=heuristic
# Reranker 兼容默认模型 ID（回退路径使用）。
RETR_RERANK_MODEL_ID=heuristic-rerank-v1
# Reranker 兼容默认 top_k（回退路径使用）。
RETR_RERANK_TOP_K=5
# Reranker 兼容默认超时时间（毫秒，回退路径使用）。
RETR_RERANK_TIMEOUT_MS=500
# Reranker 兼容默认节点选择器（回退路径使用）。
RETR_RERANK_NODE_SELECTOR=default

### Retrieval - Recall
# 是否启用 Recall 能力。
RETR_RECALL_ENABLED=true
# Recall 默认路由 ID；需能在 RETR_RECALL_ROUTES_JSON 中找到。
RETR_RECALL_DEFAULT_ROUTE=episodic_route
# Recall 路由表（JSON 对象）；每条路由包含 collection/top_k/score_weight/node_selector。
RETR_RECALL_ROUTES_JSON={"episodic_route":{"collection":"episodic","top_k":8,"score_weight":1.0,"node_selector":"default,natsu-node-01"},"canon_route":{"collection":"canon","top_k":4,"score_weight":0.75,"node_selector":"default,natsu-node-01"}}
# Recall 兼容默认集合名（回退路径使用）。
RETR_RECALL_COLLECTION=episodic
# Recall 兼容默认召回数量（回退路径使用）。
RETR_RECALL_TOP_K=8
# Recall 兼容默认分数权重（回退路径使用）。
RETR_RECALL_SCORE_WEIGHT=1.0
# Recall 兼容默认节点选择器（回退路径使用）。
RETR_RECALL_NODE_SELECTOR=default

### Sandbox
# 沙箱隔离后端；可选 subprocess/docker。
SANDBOX_ISOLATION_BACKEND=subprocess
# 是否启用沙箱能力总开关。
SANDBOX_ENABLED=true
# 沙箱执行超时时间（秒）。
SANDBOX_TIMEOUT_S=10
# 沙箱标准输出最大字节数；超出会截断。
SANDBOX_MAX_STDOUT_BYTES=65536
# 沙箱标准错误最大字节数；超出会截断。
SANDBOX_MAX_STDERR_BYTES=16384
# 沙箱可执行代码最大字节数；用于防止超大输入。
SANDBOX_MAX_CODE_BYTES=32768
# Docker 隔离后端镜像名（当 SANDBOX_ISOLATION_BACKEND=docker 时使用）。
SANDBOX_DOCKER_IMAGE=python:3.11-slim
# subprocess 模式下的 Python 可执行命令。
SANDBOX_PYTHON_EXECUTABLE=python
# 是否允许沙箱访问网络；生产建议 false。
SANDBOX_ALLOW_NETWORK=false
# 是否允许沙箱写文件系统；生产建议 false。
SANDBOX_ALLOW_FS_WRITE=false
# 是否强制要求容器后端可用；true 时容器不可用将直接失败。
SANDBOX_REQUIRE_CONTAINER=false

### Local runtime (optional)
# 本地 Java 安装目录；Neo4j 本地启动脚本可能会读取该变量，留空表示自动探测。
JAVA_HOME=

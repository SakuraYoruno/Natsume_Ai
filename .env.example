# Natsume AI 运行时配置模板（含详细中文注释）。
# 读取优先级：
#   1) 根目录 .env（本地真实配置）
#   2) 根目录 .env.example（本文件，示例/降级回退）
#
# 安全要求：
# - 所有真实密钥必须只放在本地 .env 或本地 secret store。
# - 本文件必须保持可提交状态，禁止写入真实密钥。

### Environment
# 主环境标识；可选 dev/test/prod，影响鉴权策略、冷启动策略和部分默认开关。
Natsume_ENV=dev

### Host app
# Host HTTP 服务监听地址；本机开发通常使用 127.0.0.1，对外访问可改为 0.0.0.0。
HOST_APP_HOST=127.0.0.1
# Host HTTP 服务端口；默认 18080，需确保未被占用。
HOST_APP_PORT=18080
# Host 日志级别；常用 DEBUG/INFO/WARNING/ERROR。
HOST_APP_LOG_LEVEL=INFO

### Host LLM and feature gates
# Host 主 LLM 提供商；可选 openai/gemini/deepseek/mock/disabled。
HOST_LLM_PROVIDER=openai
# Host 调用 LLM 的单次超时时间（毫秒）。
HOST_LLM_TIMEOUT_MS=15000
# Host 调用 LLM 的最大重试次数；0 表示不重试。
HOST_LLM_MAX_RETRIES=1
# 冷启动是否允许在缺失可用 LLM 密钥时继续启动（通常 dev=true，prod=false）。
HOST_COLD_START_ALLOWED=true
# 是否启用检索链路（Recall/Embedding/Reranker）。
HOST_ENABLE_RETRIEVAL=true
HOST_CHAT_DISABLE_RETRIEVAL=false
# 是否启用视觉相关能力（OCR/视觉识别等）。
HOST_ENABLE_VISION=true
# 是否启用 Host 与 Edge 的 RPC 交互能力。
HOST_ENABLE_EDGE_RPC=true

# ---- TTS 语音合成控制 ----
# 全局 TTS 开关。关闭后所有场景不再调用 post_speak() 进行语音合成。默认 true。
# HOST_STREAM_TTS_ENABLED=true
# ASR 兜底 TTS 安全网。当 SSE 生成器内部未执行 TTS 时，post_chain 补充播报。默认 true。
# 仅在 source=ASR 时生效。设为 false 可禁用兜底（依赖生成器内部 TTS 正常工作）。
# HOST_ASR_POST_CHAIN_TTS_FALLBACK=true

# ---- Skills Hub（外部 Skill 安装与管理）----
# Hub 总开关。关闭后不扫描 hub/ 目录中的外部 Skill。默认 true。
# HOST_SKILL_HUB_ENABLED=true
# Hub Skills 目录路径。默认项目根目录 skills/（外部 skill 安装在此，不混入核心代码）。
# HOST_SKILL_HUB_DIR=

# ---- 系统运行模式 (ModeTransitionService) ----
# 启动时的默认 sys_mode。可选值: normal/focus/gaming/sleep/maintenance/locked。默认 normal。
# HOST_SYS_MODE=normal
# 自定义游戏进程列表（逗号分隔的进程名，追加到内置列表）。例如: mygame.exe,anothergame.exe
# HOST_GAMING_PROCESSES=
# 空闲自动切换到 sleep 的阈值（毫秒）。默认 7200000（2 小时）。
# HOST_IDLE_THRESHOLD_MS=7200000
# ActivityMonitor 游戏进程检测间隔（秒）。默认 30。
# HOST_GAMING_CHECK_INTERVAL_S=30
# ActivityMonitor 空闲检测间隔（秒）。默认 300（5 分钟）。
# HOST_IDLE_CHECK_INTERVAL_S=300
# 远程 Skills Hub 索引 URL（用于 search 命令）。默认指向 GitHub 仓库。
# HOST_SKILL_HUB_REGISTRY_URL=https://raw.githubusercontent.com/koinosakura/natsume-skills-hub/main/registry.json
# 是否自动扫描外部 Skills 目录（SkillHub/ClawHub/OpenClaw）。默认 true。
# 扫描 ~/.skillhub/skills/、~/.openclaw/skills/、~/.codebuddy/skills/
# HOST_SKILL_SCAN_EXTERNAL=true
# 额外的外部 Skills 目录（逗号分隔）。可指向任意包含 SKILL.md 的 skill 目录集合。
# HOST_SKILL_EXTERNAL_DIRS=

# ---- LLM Base URL / 模型覆盖 ----
# 各 provider 的 API 基础地址覆盖（用于代理/兼容端点，留空则使用默认）。
# HOST_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# HOST_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# HOST_OPENAI_BASE_URL=
# 各 provider 的模型 ID 覆盖（留空则使用 provider 默认）。
# HOST_LLM_MODEL_ID=
# HOST_GEMINI_MODEL_ID=gemini-2.5-flash
# HOST_OPENAI_MODEL_ID=gpt-4o-mini
# HOST_DEEPSEEK_MODEL_ID=deepseek-chat
# Gemini 主模型容错策略。
# HOST_GEMINI_PRIMARY_DISABLE_MODEL_FALLBACK=false
# HOST_GEMINI_PRIMARY_FALLBACK_MODEL_ID=
# HOST_GEMINI_PRIMARY_RETRY_ATTEMPTS=2
# HOST_GEMINI_PRIMARY_RETRY_DELAY_MS=150

# ---- Host → Edge RPC 通信 ----
# Host 侧显式 Edge RPC 完整地址覆盖（留空则从 EDGE_RPC_HOST:EDGE_RPC_PORT 拼接）。
# HOST_EDGE_RPC_BASE_URL=
# Host 侧 Edge RPC HMAC 签名密钥（对应 Edge 侧的 EDGE_HMAC_SHARED_KEY）。模板中留空，prod 强烈建议配置。
# HOST_EDGE_RPC_SHARED_KEY=
# Host 调用 Edge RPC 的超时时间（毫秒）。默认 3000。
# HOST_EDGE_RPC_TIMEOUT_MS=3000
# Host 调用 Edge RPC 的最大重试次数。默认 1。
# HOST_EDGE_RPC_RETRIES=1
# Edge Gateway 监听主机地址（独立于 EDGE_RPC_HOST，用于消息网关探测）。
# EDGE_GATEWAY_HOST=
# HOST 侧时钟偏移补偿（毫秒），用于修正 Host/Edge 时钟不同步。默认 0。
# HOST_EDGE_CLOCK_OFFSET_MS=0
# Gaming 模式下 Edge RPC 超时（毫秒）。默认 1200。
# HOST_GAMING_EDGE_RPC_TIMEOUT_MS=1200

# ---- 语义召回（SemanticRecaller） ----
# 是否使用 Mock 模式（不依赖 Chroma）。默认 true，生产环境应设为 false。
# SEMANTIC_RECALL_USE_MOCK=true
# 语义召回 top_k 数量。默认 5。
# SEMANTIC_RECALL_TOP_K=5
# 语义召回相似度阈值。默认 0.70。
# SEMANTIC_RECALL_THRESHOLD=0.70
# Chroma 向量库独立主机/端口（与 CHROMA_ENDPOINT 并行使用）。
# CHROMA_HOST=localhost
# CHROMA_PORT=8000

# ---- 情绪系统 ----
# 情绪代谢衰减速率。默认 0.05。
# HOST_EMOTION_DECAY_RATE=0.05
# 情绪持久化层衰减速率。默认 0.1。
# HOST_EMOTION_PERSISTENCE_DECAY_RATE=0.1
# 情绪基线（valence/arousal/dominance 三维）。
# HOST_EMOTION_BASELINE_VALENCE=0.0
# HOST_EMOTION_BASELINE_AROUSAL=0.3
# HOST_EMOTION_BASELINE_DOMINANCE=0.0
# 情绪持久化文件存储目录。默认 ~/.natsume/emotion。
# NATSUME_EMOTION_PERSISTENCE_DIR=
# 情绪衰减优雅期（毫秒），期间不衰减。默认 30000。
# HOST_EMOTION_DECAY_GRACE_MS=30000
# 情绪衰减最大速率和衰减窗口（分钟）。
# HOST_EMOTION_DECAY_MAX_RATE=0.85
# HOST_EMOTION_DECAY_WINDOW_MIN=120
# 默认情绪标签和状态。
# HOST_DEFAULT_EMOTION_TAG=NEUTRAL
# HOST_DEFAULT_MOOD_STATE=steady
# HOST_DEFAULT_EMOTION_INTENSITY=0.5
# 情绪推理 LLM 模型和提供商。
# HOST_EMOTION_LLM_MODEL_ID=gemini-2.5-flash
# HOST_EMOTION_LLM_PROVIDER=gemini
# 流式输出时是否启用 VTS 表情同步。默认 true。
# HOST_STREAM_VTS_EMOTION_ENABLED=true

# ---- Bond 图谱持久化 ----
# Bond 持久化后端类型。可选 memory（重启丢失）/ sqlite（持久化，推荐 prod）。默认 memory。
# HOST_BOND_BACKEND=memory
# Bond SQLite 持久化路径（当 BOND_BACKEND=sqlite 时使用）。
# HOST_BOND_SQLITE_PATH=
# Bond 更新后台队列最大容量和开关。
# HOST_BOND_QUEUE_MAX_SIZE=1024
# HOST_BOND_QUEUE_ENABLED=true

# ---- 检索缓存 ----
# 是否启用检索结果缓存。默认 false。
# HOST_RETRIEVAL_CACHE_ENABLED=false
# 检索结果缓存 TTL（毫秒）和最大条目数。
# HOST_RETRIEVAL_CACHE_TTL_MS=3000
# HOST_RETRIEVAL_CACHE_MAX_ENTRIES=256

# ---- Agent 步数限制 ----
# Intent Agent ReAct 循环最大步数。默认 5。
# INTENT_REACT_MAX_STEPS=5
# Judge Agent ReAct 循环最大步数。默认 3。
# JUDGE_AGENT_REACT_MAX_STEPS=3
# Emotion Agent ReAct 循环最大步数。默认 3。
# EMOTION_AGENT_REACT_MAX_STEPS=3

# ---- 其他 Host 配置 ----
# 默认用户 ID（未提供时的兜底值）。
# HOST_DEFAULT_USER_ID=default_user
# 检索链路中证据条目的最大数量上限。默认 8。
# HOST_RETR_EVIDENCE_ITEMS_MAX=8
# 检索召回的 top_k 数量。默认 8。
# HOST_RETR_TOP_K=8
# 强制覆盖渲染目标语言（zh/ja/en 等，留空则自动判定）。
# HOST_RENDER_TARGET_LANG=
# 灰度发布总开关、比例、场景、用户白名单。
# HOST_CHAT_GRAY_ENABLED=false
# HOST_CHAT_GRAY_PERCENT=
# HOST_CHAT_GRAY_SCENES=CHAT
# HOST_CHAT_GRAY_USER_ALLOWLIST=
# 是否启用聊天预分类器。默认 true。
# HOST_CHAT_ENABLE_PRECLASSIFIER=true

# WeChat 入站消息是否抑制 Edge 本地 TTS（建议 true，避免收消息时本地播报）。
HOST_INPUT_WECHAT_SUPPRESS_EDGE_TTS=true
# WeChat 入站消息是否抑制 Edge 本地 VTS（建议 true，避免收消息时模型动作/热键干扰）。
HOST_INPUT_WECHAT_SUPPRESS_EDGE_VTS=true
# WeChat 入站消息是否自动回发到 WeChat 会话（建议 true）。
HOST_INPUT_WECHAT_AUTO_REPLY=true
# WeChat 入站消息是否只走直回模式（建议 true，避免拉起 LLM 链路和额外副作用）。
HOST_INPUT_WECHAT_DIRECT_REPLY_ONLY=true
# WeChat 直回模式固定回复文本。
HOST_INPUT_WECHAT_DIRECT_REPLY_TEXT=收到
# 是否屏蔽文件传输助手目标，避免误回到 FileHelper。
HOST_INPUT_WECHAT_BLOCK_FILEHELPER=true
# WeChat 自动回发是否等待 Edge 命令执行结果。
HOST_INPUT_WECHAT_REPLY_WAIT_RESULT=true
# WeChat 自动回发等待超时（毫秒）。
HOST_INPUT_WECHAT_REPLY_TIMEOUT_MS=12000
# WeChat 输入被拒绝时是否发送兜底文本回复（建议 true，避免“发了没反应”）。
HOST_INPUT_WECHAT_FALLBACK_ON_REJECT=true
# WeChat 输入被拒绝时的兜底回复文本。
HOST_INPUT_WECHAT_REJECT_FALLBACK_TEXT=刚刚处理超时了，请再发一次，我这边立即重试。
# Host 访问 Edge 时是否允许回退到本机地址（建议 false，避免误控 Host 本机）。
HOST_EDGE_RPC_ALLOW_LOCAL_FALLBACK=false
# 是否禁止微信命令发往 loopback Edge（默认 true，防止误操控 Host 本机微信）。
HOST_EDGE_RPC_BLOCK_LOOPBACK_WECHAT=true
HOST_EDGE_EVENT_ASR_AUTO_BRIDGE_ENABLED=true
HOST_EDGE_EVENT_ASR_AUTO_BRIDGE_ALLOW_CHUNK=true
HOST_EDGE_EVENT_ASR_AUTO_BRIDGE_MIN_CONFIDENCE=0.60
HOST_EDGE_EVENT_ASR_AUTO_BRIDGE_DEDUP_WINDOW_MS=6000
# 聊天路径是否默认优先使用 Host 本地 8B 模型（非 gaming）。
HOST_CHAT_HOST_8B_ENABLED=true
# 强制回滚到云端模型；true 时即使 8B 可用也不走本地 8B。
HOST_CHAT_FORCE_CLOUD=false
# Host 本地 8B provider（建议 openai 兼容本地网关）。
HOST_CHAT_HOST_8B_PROVIDER=openai
# Host 本地 8B 模型 ID（Ollama 默认可用值 `qwen3:14b`，可按本机标签覆盖）。
HOST_CHAT_HOST_8B_MODEL_ID=qwen3:14b
# Host 本地 8B 调用超时（毫秒）。
HOST_CHAT_HOST_8B_TIMEOUT_MS=12000
# Host 本地 8B API 基址（可选，OpenAI 兼容）；Ollama 建议使用 /v1。
HOST_CHAT_HOST_8B_BASE_URL=http://127.0.0.1:11434/v1
# Host 本地 8B 专用 API Key（可选，留空则尝试 provider 默认键）。
HOST_CHAT_HOST_8B_API_KEY=
# 是否允许无密钥场景使用占位 key（本地网关常用）。
HOST_CHAT_HOST_8B_ALLOW_EMPTY_KEY=true
# 是否启用 Host 8B 健康检查；失败时自动降级到 Cloud。
HOST_CHAT_HOST_8B_HEALTHCHECK_ENABLED=true
# Host 8B 健康检查地址（可选）；为空时按 base_url 探测 /health 和 /v1/models。
HOST_CHAT_HOST_8B_HEALTHCHECK_URL=
# Host 8B 就绪标记（兜底门控）；设为 false 会强制降级到 Cloud。
HOST_CHAT_HOST_8B_READY=true
# 复杂任务云端 provider（非 chat_direct 节点），默认 gemini。
HOST_CHAT_CLOUD_PROVIDER=gemini

### Host rate limit
# Host 限流后端；可选 memory/sqlite/redis。
HOST_RATE_LIMIT_BACKEND=memory
# 限流时间窗口（毫秒）；在该窗口内统计请求数。
HOST_RATE_LIMIT_WINDOW_MS=60000
# 限流窗口内最大请求数；超过后按策略拒绝或降级。
HOST_RATE_LIMIT_MAX_REQUESTS=30
# 当限流后端为 sqlite 时使用的数据库路径；为空表示使用默认路径。
HOST_RATE_LIMIT_SQLITE_DB_PATH=
# 当限流后端为 redis 时的连接地址。
HOST_RATE_LIMIT_REDIS_URL=redis://127.0.0.1:6379/0
# Redis 限流键前缀；用于隔离不同环境/项目的键空间。
HOST_RATE_LIMIT_REDIS_KEY_PREFIX=natsume:rate_limit:
# Redis 请求超时时间（毫秒）；过小可能导致误判不可用。
HOST_RATE_LIMIT_REDIS_TIMEOUT_MS=1000

### API keys (keep empty in template)
# OpenAI API Key；模板中必须留空，运行时在本地 .env 填写。
OPENAI_API_KEY=
# Gemini API Key；模板中必须留空，运行时在本地 .env 填写。
GEMINI_API_KEY=
# DeepSeek API Key；模板中必须留空，运行时在本地 .env 填写。
DEEPSEEK_API_KEY=
# LangSmith API Key；用于链路追踪上报，模板中必须留空。
LANGSMITH_API_KEY=

### API key refs (non-secret identifiers)
# OpenAI 密钥引用标识（非密钥）；用于从 secret store 解析真实密钥。
OPENAI_API_KEY_REF=sec://llm/openai/default
# Gemini 密钥引用标识（非密钥）；用于从 secret store 解析真实密钥。
GEMINI_API_KEY_REF=sec://llm/gemini/default
# DeepSeek 密钥引用标识（非密钥）；用于从 secret store 解析真实密钥。
DEEPSEEK_API_KEY_REF=sec://llm/deepseek/default

### Host runtime
# Host 审计账本数据库路径（SQLite）；建议放在本地磁盘。
Natsume_AUDIT_DB=host_brain/data/audit.sqlite3
# CORS 允许来源；可填逗号分隔域名列表，留空表示使用服务默认策略。
Natsume_CORS_ORIGINS=
# World Canon 根目录路径；用于加载世界观常识与规则素材。
Natsume_WORLD_CANON_ROOT=host_brain/canon/world
# 是否在控制台启用运行时监控输出；true 会增加控制台日志噪声。
Natsume_RUNTIME_MONITOR_CONSOLE=false
# 可观测模式开关；通常 dev 使用调试模式，prod 使用生产模式。
OBS_MODE=prod
# P8-1：扩展观测聚合开关（subgraph/local loop 失败分布 + 三图延迟分布 + Intent budget breach 聚合）。
# 默认 false；开启后 /obs/metrics 返回值追加 subgraph_failure_metrics、local_loop_failure_metrics、
# intent_budget_breach_metrics、graph_latency_metrics 四个字段，不影响已有字段。
P8_EXTENDED_METRICS_ENABLED=false

# P9-1：code_agent ReAct 循环最大步数（默认 3，范围建议 1-5）。
CODE_AGENT_REACT_MAX_STEPS=3
# P10-1：translate_agent ReAct 循环最大步数（默认 3，范围建议 1-5）。
TRANSLATE_AGENT_REACT_MAX_STEPS=3
# P12-1：retrieval_agent ReAct 循环最大步数（默认 3，范围建议 1-5）。
RETRIEVAL_AGENT_REACT_MAX_STEPS=3

### LangSmith (optional)
# 是否启用 LangSmith 链路追踪。
LANGSMITH_TRACING=false
# LangSmith 项目名；启用追踪时建议设置，便于多项目隔离。
LANGSMITH_PROJECT=
# LangSmith API 端点；默认官方服务地址。
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

### Edge RPC
# Edge RPC 网关监听地址；本机开发通常为 127.0.0.1。
EDGE_RPC_HOST=127.0.0.1
# Edge RPC 网关监听端口；默认 17800。
EDGE_RPC_PORT=17800
# 是否允许不安全鉴权；仅建议 dev/test 使用，prod 应设为 false。
EDGE_ALLOW_INSECURE_AUTH=true
# RPC 请求时间戳鉴权窗口（毫秒）；超出窗口会被拒绝。
EDGE_RPC_AUTH_WINDOW_MS=15000
# RPC nonce 去重时间窗口（毫秒）；用于重放攻击防护。
EDGE_RPC_NONCE_WINDOW_MS=120000
# 是否启用 Edge RPC 网关主开关；关闭后相关语音链路将不可用或降级。
EDGE_RPC_GATEWAY_ENABLED=true

### Edge feature gates
# 是否启用 Edge ASR（语音识别）能力。
EDGE_ASR_ENABLED=true
# 是否启用 Edge TTS（语音合成）能力。
EDGE_TTS_ENABLED=true
# 是否启用打断（barge-in）能力；通常依赖 TTS 开启。
EDGE_BARGE_IN_ENABLED=true
# 是否启用 Edge 侧兜底小模型能力。
EDGE_FALLBACK_LLM_ENABLED=false
# 是否启用 Edge 资源门控（显存/队列保护）。
EDGE_RESOURCE_GATE_ENABLED=true
# Edge 可用显存上限（MB）；超过后会触发降级或抢占策略。
EDGE_MAX_VRAM_MB=4096
# Edge 请求队列最大长度；超过后新请求可能被拒绝或降级。
EDGE_MAX_QUEUE_LENGTH=8
# 资源门控软阈值比例（0~1）；达到该比例开始趋向保守调度。
EDGE_RESOURCE_GATE_VRAM_SOFT_LIMIT_RATIO=0.9
# 资源门控允许的兜底队列深度；用于保护主链路吞吐。
EDGE_RESOURCE_GATE_MAX_FALLBACK_QUEUE_DEPTH=1

### Edge auth secret (keep empty in template)
# Edge RPC HMAC 共享密钥；模板中必须留空，prod 场景强烈建议配置。
EDGE_HMAC_SHARED_KEY=
# Edge HMAC 密钥引用标识（非密钥）；用于从 secret store 解析真实密钥。
EDGE_HMAC_SHARED_KEY_REF=sec://edge/hmac/default

### Edge ASR
# ASR 模型标识或本地模型目录；例如 large-v3。
EDGE_ASR_MODEL_SIZE=large-v3
# ASR 推理设备；可选 cuda/cpu。
EDGE_ASR_DEVICE=cuda
# ASR 计算精度；常见 float16/int8/float32。
EDGE_ASR_COMPUTE_TYPE=float16
# ASR beam size；越大通常精度更高但速度更慢。
EDGE_ASR_BEAM_SIZE=5
# ASR 音频采样率（Hz）；需与采集链路一致。
EDGE_ASR_SAMPLE_RATE=16000
# ASR 音频通道数；单声道通常设为 1。
EDGE_ASR_CHANNELS=1
# ASR 分块时长（秒）；越小延迟更低但开销更高。
EDGE_ASR_CHUNK_DURATION_S=0.5
# VAD 阈值；越高越保守，越低越容易误触发语音段。
EDGE_ASR_VAD_THRESHOLD=0.5
# 判定静音结束所需最小时长（秒）。
EDGE_ASR_SILENCE_DURATION_S=0.8
# 语音片段最小时长（秒）；小于该值可能被过滤。
EDGE_ASR_MIN_SPEECH_DURATION_S=0.3
# 单段语音最长期限（秒）；超过后会被切段或强制结束。
EDGE_ASR_MAX_SPEECH_DURATION_S=30.0
# 低能量预检最小峰值；与 RMS 门槛一起抑制静音/底噪段幻听。
EDGE_ASR_PRECHECK_MIN_PEAK=0.01
# 低能量预检最小 RMS；推荐与 PRECHECK_MIN_PEAK 配合使用。
EDGE_ASR_PRECHECK_MIN_RMS=0.002
# 是否启用 faster-whisper 内部 VAD；真实采集/虚拟声卡链路推荐 false。
EDGE_ASR_USE_VAD_FILTER=true
# VAD 为空时是否自动关闭 VAD 重试一次。
EDGE_ASR_VAD_RETRY_WITHOUT_FILTER_ON_EMPTY=true
# 触发“关闭 VAD 重试”的最小峰值。
EDGE_ASR_VAD_RETRY_MIN_PEAK=0.015
# ASR 识别语言；如 ja/zh/en，可留空走自动识别策略（若模型支持）。
EDGE_ASR_LANGUAGE=zh
# ASR 初始提示词；用于提升特定术语识别，可留空。
EDGE_ASR_INITIAL_PROMPT=
# 指定 GPU 设备索引；留空表示使用默认设备。
EDGE_ASR_DEVICE_INDEX=
# ASR 自动恢复最大尝试次数。
EDGE_ASR_RECOVERY_MAX_ATTEMPTS=5
# ASR 自动恢复基础退避时间（秒）。
EDGE_ASR_RECOVERY_BASE_DELAY_S=1.0
# ASR 自动恢复最大退避时间（秒）。
EDGE_ASR_RECOVERY_MAX_DELAY_S=8.0
# 是否启用 ASR 自动恢复。
EDGE_ASR_RECOVERY_AUTO=true
# 自动恢复时是否尝试切换候选设备（例如多 GPU 场景）。
EDGE_ASR_RECOVERY_TRY_ALTERNATE_DEVICES=true

### Edge TTS
# TTS 模型根路径；应包含推理所需权重与配置文件。
EDGE_TTS_MODEL_PATH=models/gpt_sovits
# TTS 推理设备；可选 cuda/cpu。
EDGE_TTS_DEVICE=cuda
# TTS 输出采样率（Hz）；需与播放链路兼容。
EDGE_TTS_SAMPLE_RATE=32000
# 单次 TTS 最大文本长度；超出需上层切分。
EDGE_TTS_MAX_TEXT_LENGTH=500
# TTS 单次合成超时时间（秒）。
EDGE_TTS_SYNTH_TIMEOUT_S=30.0
# TTS 参考音频路径（可选）；用于音色/风格迁移。
EDGE_TTS_REF_AUDIO_PATH=
# TTS 参考文本（可选）；与参考音频配套使用。
EDGE_TTS_REF_TEXT=
# TTS 目标语言；如 ja/zh/en，具体受模型能力限制。
EDGE_TTS_LANGUAGE=ja
# 播放设备索引；留空表示系统默认输出设备。
EDGE_TTS_PLAYBACK_DEVICE_INDEX=
# Edge 兜底小模型 ID；仅在 EDGE_FALLBACK_LLM_ENABLED=true 时生效。
EDGE_FALLBACK_LLM_MODEL_ID=ollama:3b-q4

### Edge VTS
# VTube Studio API 主机地址；本机一般为 localhost。
EDGE_VTS_HOST=localhost
# VTube Studio API 端口；默认 8001。
EDGE_VTS_PORT=8001
# VTube Studio 插件名称；用于鉴权弹窗和会话识别。
EDGE_VTS_PLUGIN_NAME=NatsumeAi
# VTube Studio 插件开发者名称；用于鉴权弹窗展示。
EDGE_VTS_PLUGIN_DEVELOPER=Natsume
# VTube Studio token 保存路径；首次授权后用于复用会话。
EDGE_VTS_TOKEN_PATH=.vts_token
# 调用 VTS API 的请求超时时间（秒）。
EDGE_VTS_API_TIMEOUT_S=5.0
# 口型主参数候选，按顺序优先匹配当前模型可用的 VTS input parameter。
EDGE_VTS_MOUTH_PARAM_CANDIDATES=MouthOpen,ParamMouthOpenY
# 口型音量参数候选；若模型映射的是音量驱动口型，可在此覆盖。
EDGE_VTS_MOUTH_VOLUME_PARAM_CANDIDATES=VoiceVolumePlusMouthOpen,VoiceVolume
# 口型静音门控参数候选；默认保持 VoiceSilence=1 以避免 VTS 抢回控制。
EDGE_VTS_VOICE_SILENCE_PARAM_CANDIDATES=VoiceSilence
# VTS 断线重连最大尝试次数。
EDGE_VTS_RECONNECT_MAX_ATTEMPTS=10
# VTS 重连基础退避时间（秒）。
EDGE_VTS_RECONNECT_BASE_DELAY_S=1.0
# VTS 重连最大退避时间（秒）。
EDGE_VTS_RECONNECT_MAX_DELAY_S=16.0
# 是否启用 VTS 自动重连。
EDGE_VTS_RECONNECT_AUTO=true
# 是否在启动 Edge 时自动尝试拉起 VTube Studio（Steam 协议）。
EDGE_VTS_AUTOSTART=false
# VTube Studio 的 Steam App ID。
EDGE_VTS_STEAM_APP_ID=1325860
# 自动拉起后等待 VTS 端口就绪的超时时间（秒）。
EDGE_VTS_AUTOSTART_WAIT_SECONDS=35
# VTS API 端口别名变量；供部分旧逻辑或脚本兼容读取。
VTS_API_PORT=8001

### Edge service ports
# Edge ASR 子服务健康探测端口。
EDGE_ASR_PORT=17801
# Edge TTS 子服务健康探测端口。
EDGE_TTS_PORT=17802

### Edge event reporting
# Edge 事件离线缓存最大条数；超出后按策略丢弃最旧事件。
EDGE_EVENT_REPORT_MAX_CACHE_EVENTS=1000
# Edge 事件离线缓存最大字节数；用于限制本地缓存体积。
EDGE_EVENT_REPORT_MAX_CACHE_BYTES=10485760
# 事件上报最大重试次数。
EDGE_EVENT_REPORT_MAX_RETRY_ATTEMPTS=5
# 事件上报重试基础退避时间（秒）。
EDGE_EVENT_REPORT_BASE_RETRY_DELAY_S=1.0
# 事件上报重试最大退避时间（秒）。
EDGE_EVENT_REPORT_MAX_RETRY_DELAY_S=30.0

### Neo4j (Bond)
# 是否启用 Neo4j 依赖；关闭后 Bond 图能力会降级或不可用。
BOND_NEO4J_ENABLED=true
# Neo4j 连接 URI；本地默认 bolt://127.0.0.1:7687。
BOND_NEO4J_URI=bolt://127.0.0.1:7687
# Neo4j 数据库名；Neo4j 5+ 可多数据库。
BOND_NEO4J_DATABASE=neo4j
# Neo4j 凭据引用标识（非密钥）；映射到 secret store 中 user:password 或 password。
BOND_NEO4J_AUTH_REF=sec://neo4j/local-default
# Neo4j 连接池大小；并发高时可适当提高。
BOND_NEO4J_POOL_SIZE=50
# 是否启用 Neo4j TLS；公网或跨机访问建议开启并配置证书。
BOND_NEO4J_TLS_ENABLED=false

### Chroma (Memory)
# 是否启用 Chroma 向量库依赖。
CHROMA_ENABLED=true
# Chroma HTTP 端点地址。Windows 上 8000/8100 常被系统保留，建议使用 18000。
CHROMA_ENDPOINT=http://127.0.0.1:18000
# Chroma tenant 名称；用于租户级隔离。
CHROMA_TENANT=default_tenant
# Chroma database 名称；用于库级隔离。
CHROMA_DATABASE=default_database
# 默认向量集合名称；未指定集合时使用该值。
CHROMA_DEFAULT_COLLECTION=episodic
# Chroma 仅承载 episodic_vector 路由，其他逻辑库不走 collection。
# 如切换 Embedding 模型维度，需同步修改 episodic collection 的维度并重建。
CHROMA_COLLECTION_PROFILES_JSON={"episodic":1024}
CANON_VECTOR_AUTO_SYNC_ENABLED=true
CANON_VECTOR_AUTO_SYNC_MODE=async
CANON_VECTOR_COLLECTION=canon
CANON_VECTOR_BACKEND=http
CANON_VECTOR_EMBED_TIMEOUT_MS=60000

### Retrieval - Embedding
# 是否启用 Embedding 能力。
RETR_EMBED_ENABLED=true
# Embedding 默认路由 ID；需能在 RETR_EMBED_ROUTES_JSON 中找到。
RETR_EMBED_DEFAULT_ROUTE=host_default
# Embedding 路由表（JSON 对象）；每条路由包含 provider/model_id/dim/timeout_ms/node_selector。
# Qwen3-Embedding-0.6B：中文语义质量高，dim=1024，需 GPU 推理（RTX 5080 16G 约 10-30ms/条）。
# 本地模型路径示例：models/Qwen3-Embedding-0.6B（从 HuggingFace 下载后放到 models/ 目录）。
RETR_EMBED_ROUTES_JSON={"host_default":{"provider":"sentence_transformers","model_id":"Qwen/Qwen3-Embedding-0.6B","dim":1024,"timeout_ms":20000,"node_selector":"default,natsu-node-01"}}
# Embedding 推理设备（部分 provider 使用）；如 cpu/cuda。
RETR_EMBED_DEVICE=cuda
# Embedding 兼容默认 provider（当未走路由 JSON 或回退路径时使用）。
RETR_EMBED_PROVIDER=builtin_hash
# Embedding 兼容默认模型 ID（回退路径使用）。
RETR_EMBED_MODEL_ID=hash-embed-v1
# Embedding 兼容默认向量维度（回退路径使用）。
RETR_EMBED_DIM=1024
# Embedding 兼容默认超时时间（毫秒，回退路径使用）。
RETR_EMBED_TIMEOUT_MS=500
# Embedding 兼容默认节点选择器（回退路径使用）。
RETR_EMBED_NODE_SELECTOR=default

### Retrieval - Reranker
# 是否启用 Reranker 能力。
RETR_RERANK_ENABLED=true
# Reranker 默认路由 ID；需能在 RETR_RERANK_ROUTES_JSON 中找到。
RETR_RERANK_DEFAULT_ROUTE=host_default
# Reranker 路由表（JSON 对象）；每条路由包含 provider/model_id/top_k/timeout_ms/node_selector。
# Qwen3-Reranker-0.6B：生成式重排，中文语义质量高，需使用 qwen3_reranker provider（非 cross_encoder）。
# RTX 5080 16G 约 50-200ms/批（20条候选），timeout_ms 建议 30000。
# 本地模型路径示例：models/Qwen3-Reranker-0.6B（从 HuggingFace 下载后放到 models/ 目录）。
RETR_RERANK_ROUTES_JSON={"host_default":{"provider":"qwen3_reranker","model_id":"Qwen/Qwen3-Reranker-0.6B","top_k":5,"timeout_ms":30000,"node_selector":"default,natsu-node-01"}}
# Reranker 推理设备（部分 provider 使用）；如 cpu/cuda。
RETR_RERANK_DEVICE=cuda
# Reranker 兼容默认 provider（回退路径使用）。
RETR_RERANK_PROVIDER=heuristic
# Reranker 兼容默认模型 ID（回退路径使用）。
RETR_RERANK_MODEL_ID=heuristic-rerank-v1
# Reranker 兼容默认 top_k（回退路径使用）。
RETR_RERANK_TOP_K=5
# Reranker 兼容默认超时时间（毫秒，回退路径使用）。
RETR_RERANK_TIMEOUT_MS=500
# Reranker 兼容默认节点选择器（回退路径使用）。
RETR_RERANK_NODE_SELECTOR=default

### Retrieval - Recall
# 是否启用 Recall 能力。
RETR_RECALL_ENABLED=true
# Recall 默认路由 ID；需能在 RETR_RECALL_ROUTES_JSON 中找到。
RETR_RECALL_DEFAULT_ROUTE=route_episodic
# Recall 路由表（JSON 对象）。
# Phase XIII 精简：9路→5路。剔除的4路已被独立通道替代：
#   - style_canon_zh/ja → StyleCanon v5 常驻注入（build_node_style_bindings 直读文件）
#   - persona_utterance_zh/ja → EmotionTaggedUtteranceIndex 独立通道（按 emotion_tag 场景匹配）
# 保留的5路全部设 render_target_lang_selector="*"（语种无关）。
RETR_RECALL_ROUTES_JSON={"route_episodic":{"store_id":"episodic_vector","collection":"episodic","top_k":8,"score_weight":0.9,"node_selector":"*","render_target_lang_selector":"*"},"route_sqlite_ledger":{"store_id":"sqlite_ledger","top_k":6,"score_weight":1.0,"node_selector":"*","render_target_lang_selector":"*"},"route_neo4j_bond":{"store_id":"neo4j_bond","top_k":4,"score_weight":0.95,"node_selector":"*","render_target_lang_selector":"*"},"route_world_canon":{"store_id":"world_canon","collection":"canon","top_k":4,"score_weight":0.8,"node_selector":"*","render_target_lang_selector":"*"},"route_artifact_vault":{"store_id":"artifact_vault","top_k":4,"score_weight":0.75,"node_selector":"*","render_target_lang_selector":"*"}}
# Recall 兼容默认集合名（回退路径使用）。
RETR_RECALL_COLLECTION=episodic
# Recall 兼容默认召回数量（回退路径使用）。
RETR_RECALL_TOP_K=8
# Recall 兼容默认分数权重（回退路径使用）。
RETR_RECALL_SCORE_WEIGHT=1.0
# Recall 兼容默认节点选择器（回退路径使用）。
RETR_RECALL_NODE_SELECTOR=default

### Sandbox
# 沙箱隔离后端；可选 subprocess/docker。
SANDBOX_ISOLATION_BACKEND=subprocess
# 是否启用沙箱能力总开关。
SANDBOX_ENABLED=true
# 沙箱执行超时时间（秒）。
SANDBOX_TIMEOUT_S=10
# 沙箱标准输出最大字节数；超出会截断。
SANDBOX_MAX_STDOUT_BYTES=65536
# 沙箱标准错误最大字节数；超出会截断。
SANDBOX_MAX_STDERR_BYTES=16384
# 沙箱可执行代码最大字节数；用于防止超大输入。
SANDBOX_MAX_CODE_BYTES=32768
# Docker 隔离后端镜像名（当 SANDBOX_ISOLATION_BACKEND=docker 时使用）。
SANDBOX_DOCKER_IMAGE=python:3.11-slim
# subprocess 模式下的 Python 可执行命令。
SANDBOX_PYTHON_EXECUTABLE=python
# 是否允许沙箱访问网络；生产建议 false。
SANDBOX_ALLOW_NETWORK=false
# 是否允许沙箱写文件系统；生产建议 false。
SANDBOX_ALLOW_FS_WRITE=false
# 是否强制要求容器后端可用；true 时容器不可用将直接失败。
SANDBOX_REQUIRE_CONTAINER=false

### Multi-Agent / 执行模式（P2 收敛，见 REFACTOR §4）
# 路由由 execution_profile 决定（入口层写入），不再使用 MULTI_AGENT_ENABLED / HOST_GRAPH_SCENE_ROUTER_ENABLED。
# Supervisor 分派模式：rule = 规则路由，llm = LLM 提案分派（原 SUPERVISOR_AUTO_ENABLED 收敛为此）。
SUPERVISOR_MODE=rule
# 执行意图模式：chain = 链式执行，subgraph = 子图封装（原 INTENT_SUBGRAPH_ENABLED 收敛为此）。
# INTENT_EXEC_MODE=chain
# 只读并行 agent 启用；false = 不开放并行子 agent。
READONLY_PARALLEL_ENABLED=false

### Unified Message Gateway
# 是否启用统一消息网关（Gateway）；关闭后微信/QQ/飞书/企微等平台消息路由不可用。
EDGE_GATEWAY_ENABLED=true
# Gateway 监听端口；默认 19000，需确保未被占用。
EDGE_GATEWAY_PORT=19000
# 启用的平台列表（逗号分隔）：wechat,qq,feishu,wecom,telegram,line
EDGE_GATEWAY_PLATFORMS=wechat,qq,feishu,wecom,telegram,line

# ---- 微信 4.x bridge（UIA / wxautox4）----
# 默认启用微信 bridge；负责 inbound webhook + outbound command queue。
EDGE_WECHAT_BRIDGE_ENABLED=true
# bridge 后端：uia 为本地 UIAutomation；wxautox4 为 wxautox4 包（需购买激活码）；external 为外部插件/回调。
# wxautox4 方案：pip install wxautox4 && wxautox4 -a <激活码>，微信需 4.0.5+ 版本。
EDGE_WECHAT_BRIDGE_BACKEND=wxautox4
# inbound 后端：仅保留纯 UIAutomation 主链。
EDGE_WECHAT_INBOUND_BACKEND=uia_hook
EDGE_WECHAT_UIA_MAIN_WINDOW_CLASSES=mmui::ChatSingleWindow,WeixinMainWndForPC,WeChatMainWndForPC,Qt51514QWindowIcon
EDGE_WECHAT_UIA_CHAT_WINDOW_CLASSES=mmui::ChatSingleWindow
EDGE_WECHAT_UIA_MESSAGE_LIST_CLASSES=mmui::ChatRecordListView,mmui::ChatRecordList
EDGE_WECHAT_UIA_MESSAGE_ITEM_CLASSES=mmui::ChatTextItemView
EDGE_WECHAT_UIA_EDITOR_CLASSES=mmui::ChatInputTextEdit,mmui::InputTextEdit,Edit
EDGE_WECHAT_UIA_TITLE_CLASSES=mmui::ChatHeaderTitle,Text
EDGE_WECHAT_UIA_SEARCH_CLASSES=Search,搜索,Edit

# 多聊天轮询：扫描左侧列表未读标记，自动切换收取其他聊天的消息。
# 默认关闭，因为切换聊天会短暂导致 UI 跳动。仅在需要监听多个聊天时开启。
# EDGE_WECHAT_MULTI_CHAT_POLL=false
# 多聊天轮询间隔（秒）。建议 ≥ 5.0，避免频繁切换影响 UI。
# EDGE_WECHAT_MULTI_CHAT_POLL_INTERVAL_S=5.0

# 微信媒体文件缓存目录监控：检测接收到的图片/语音/视频文件，关联到消息中。
# 需要指定微信数据目录（包含 FileStorage 子目录的那个路径）。
# 示例：C:\Users\xxx\Documents\xwechat_files\wxid_xxx
# EDGE_WECHAT_CACHE_DIR=
# 是否启用缓存监控（默认 false）。启用后会定期扫描 FileStorage 下的新增文件。
# EDGE_WECHAT_CACHE_WATCH_ENABLED=false
# 文件在"最近文件"缓存中的存活时间（秒）。超过此时间的文件不会被关联。
# EDGE_WECHAT_CACHE_WATCH_TTL_S=30.0

# ---- 微信 4.x UIAutomation 高级配置 ----
# UI 树恢复：微信 4.1.5+ 采用"按需暴露"策略，开启后 UIA Bridge 会自动尝试
# 伪装为无障碍客户端以触发完整 UI 树加载。默认开启。
WECHAT_UI_TREE_RECOVERY=true
# UIA Bridge 自动启动：Gateway 启动时是否自动启动 UIA Bridge 子进程（含看门狗重启）。
# 设为 false 则需手动运行 `python tools/wechat_uia_bridge.py`。默认跟随 EDGE_WECHAT_BRIDGE_ENABLED。
EDGE_WECHAT_UIA_BRIDGE_AUTO_START=true
# 消息发送间隔随机化（秒），防风控。默认 1.0。
# WECHAT_SEND_INTERVAL_SEC=1.0

# ---- wxautox4 bridge 专用配置 ----
# wxautox4 监听目标列表（逗号分隔）；留空则使用 GetNewMessage() 全量轮询。
# 示例：好友昵称1,好友昵称2,群聊名称
# EDGE_WECHAT_WXAUTOX4_LISTEN_TARGETS=

# [Phase 1] IsOnline health check interval in seconds (default: 30; 0 = disabled)
# EDGE_WECHAT_WXAUTOX4_HEALTH_INTERVAL_S=30

# [Phase 1] Directory to auto-download inbound media (image/voice/video). Empty = disabled.
# EDGE_WECHAT_WXAUTOX4_MEDIA_DOWNLOAD_DIR=

# [Phase 3] Message object cache TTL in seconds for advanced ops (delete/capture/quote).
# Cached msg objects expire after this duration. Default: 300 (5 minutes).
# EDGE_WECHAT_WXAUTOX4_MSG_CACHE_TTL_S=300

# wxautox4 inbound 消息轮询间隔（秒）。建议 ≥ 0.5，避免频繁调用。
# EDGE_WECHAT_INBOUND_POLL_INTERVAL_S=1.0

# wxautox4/UIA bridge 命令队列轮询间隔（秒）。默认 0.5。
# EDGE_WECHAT_COMMAND_POLL_INTERVAL_S=0.5

# Gateway 等待 bridge 返回命令结果的超时时间（毫秒）。默认 8000。
# 查询类命令（get_friends 等）会自动使用 3 倍超时。
# EDGE_WECHAT_COMMAND_TIMEOUT_MS=8000

# webhook 回调超时（秒），bridge → Gateway 的 POST 超时。默认 6.0。
# EDGE_WECHAT_CALLBACK_TIMEOUT_S=6.0

# 消息去重窗口（秒）。同一消息在此窗口内重复到达会被丢弃。默认 12.0。
# EDGE_WECHAT_LISTENER_DEDUP_WINDOW_S=12.0

# 命令队列文件路径。默认：runtime/edge/wechat_command_queue.jsonl（相对仓库根目录）。
# EDGE_WECHAT_COMMAND_QUEUE_FILE=

# 命令结果文件路径。默认：runtime/edge/wechat_command_result.jsonl。
# EDGE_WECHAT_COMMAND_RESULT_FILE=

# ---- Gateway 拟人化发送（humanize_sender，适用于所有平台）----
# 总开关。关闭后所有平台回退为一次性发送。默认 True。
# EDGE_HUMANIZE_ENABLED=true
# 模拟打字速度（字符/秒）。越小越慢（更像真人），越大越快。默认 12。
# EDGE_HUMANIZE_TYPING_SPEED_CPS=12
# 首段基础延迟（秒）。模拟"看到消息→开始打字"的反应时间。默认 0.3。
# EDGE_HUMANIZE_BASE_DELAY_S=0.3
# 单段最大延迟（秒）。防止超长文本等待过久。默认 8.0。
# EDGE_HUMANIZE_MAX_DELAY_S=8.0
# 段间最小间隔（秒）。多段消息之间的停顿下限。默认 0.5。
# EDGE_HUMANIZE_SEGMENT_GAP_MIN=0.5
# 段间最大间隔（秒）。多段消息之间的停顿上限。默认 2.5。
# EDGE_HUMANIZE_SEGMENT_GAP_MAX=2.5
# 最大分段数。超出后合并到最后一段。默认 5。
# EDGE_HUMANIZE_MAX_SEGMENTS=5
# 单段最大字符数。默认 200。
# EDGE_HUMANIZE_SEGMENT_MAX_LEN=200
# 延迟随机抖动幅度（0.0-1.0）。0=无抖动，0.2=±20%。默认 0.2。
# EDGE_HUMANIZE_JITTER=0.2

# ---- 微信（WeChatAdapter + WxDbService）----
# 本机微信账号的 wxid；用于过滤自己发出的消息，留空则不过滤。
WECHAT_SELF_WXID=
# 微信 db_storage 目录路径；用于 wx4_decrypt.py 解密数据库。
# 示例：C:\Users\xxx\Documents\xwechat_files\wxid_xxx\db_storage
WECHAT_DB_STORAGE_DIR=
# 解密后数据库输出目录；WxDbService 从此目录读取联系人/消息/朋友圈。
# 仅使用 UIAutomation 主链路时可留空；配置后会额外启用联系人映射 / 历史查询 / DB 增量监听。
# 示例：C:\Users\xxx\Documents\xwechat_files\wxid_xxx\decrypted
WECHAT_DECRYPT_OUTPUT_DIR=
# 密钥缓存文件路径（可选）；微信不重新登录密钥不变，缓存后无需重复扫描进程内存。
# 示例：C:\Users\xxx\Documents\xwechat_files\wxid_xxx\key_cache.json
WECHAT_KEY_CACHE_PATH=
# 微信数据库变更轮询间隔（秒）；watchdog 检测到文件变化后触发增量读取。
WECHAT_POLL_INTERVAL_S=5
# 微信数据库定期重新解密间隔（秒）；默认 3600（1小时），微信重新登录后需手动调用 /v1/edge/wx/refresh。
WECHAT_DECRYPT_REFRESH_INTERVAL_S=3600

# ---- QQ（QQAdapter，OneBot v11）----
# OneBot v11 HTTP API 地址；NapCat/Lagrange.Core 默认 http://127.0.0.1:3000。
# 留空表示不启用 QQ 适配器。
QQ_ONEBOT_API_BASE=
# 本机 QQ 号；用于过滤自己发出的消息，留空则不过滤。
QQ_SELF_ID=
# 是否由 Edge 启停脚本负责管理本机 OneBot/NapCat 进程；默认 false。
EDGE_QQ_ONEBOT_AUTOSTART=false
# OneBot/NapCat 启动器路径，例如 D:\Apps\NapCat.Shell\launcher-user.bat
EDGE_QQ_ONEBOT_LAUNCHER_PATH=
# 启动器参数；支持 {QQ_SELF_ID} / {QQ_ONEBOT_API_BASE} 模板占位符。
EDGE_QQ_ONEBOT_LAUNCHER_ARGS=
# OneBot/NapCat 工作目录；留空则默认取启动器所在目录。
EDGE_QQ_ONEBOT_WORKDIR=
# 启动前是否强制关闭已有 QQ 进程，避免 NapCat 注入到普通 QQ 进程失败。
EDGE_QQ_ONEBOT_KILL_QQ_BEFORE_START=false
# OneBot 健康检查地址；留空则默认使用 QQ_ONEBOT_API_BASE + /get_status。
EDGE_QQ_ONEBOT_HEALTH_URL=
# OneBot 启动后等待健康就绪的秒数。
EDGE_QQ_ONEBOT_START_WAIT_SECONDS=60

# ---- 飞书（FeishuAdapter，Open API）---
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=

# ---- 企微（WeComAdapter，企业微信 API）---
WECOM_CORP_ID=
WECOM_CORP_SECRET=
WECOM_AGENT_ID=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=

# ---- Telegram Userbot（TelegramAdapter，Telethon MTProto）----
# 使用普通用户身份登录 Telegram，对方看到的是正常联系人（非 Bot）。
# 获取 API ID/Hash：https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# 手机号（含国际区号，如 +8613800138000）；首次登录需在终端输入验证码。
TELEGRAM_PHONE=
# Telethon session 文件名（默认 nanami），缓存登录态，下次启动无需重新验证。
TELEGRAM_SESSION_NAME=nanami
# 自身用户 ID（可选，启动时自动获取），用于过滤自己发出的消息。
TELEGRAM_SELF_ID=
# 人感增强参数：模拟打字速度（字符/秒），回复最小/最大延迟（秒）。
TELEGRAM_TYPING_SPEED=15.0
TELEGRAM_MIN_DELAY_S=1.0
TELEGRAM_MAX_DELAY_S=3.0
# 代理配置（可选）；需要翻墙的网络环境下配置 socks5/http 代理。
TELEGRAM_PROXY_TYPE=
TELEGRAM_PROXY_ADDR=
TELEGRAM_PROXY_PORT=

# ---- LINE Messaging API（LineAdapter）----
# LINE 官方 Messaging API：https://developers.line.biz/
# 在 LINE Developers Console 创建 Messaging API Channel 后获取以下凭据。
# Channel Access Token（长期有效）：Channel 设置 → Messaging API → Channel access token。
LINE_CHANNEL_ACCESS_TOKEN=
# Channel Secret：Channel 设置 → Basic settings → Channel secret。
LINE_CHANNEL_SECRET=
# Webhook URL 配置：将 Gateway 的外网地址填入 LINE Console：
#   https://your-domain.com/v1/gateway/line/webhook
# 注意：LINE 要求 Webhook 地址为 HTTPS，本地开发可用 ngrok 等工具暴露。

# 启用 VLM
EDGE_VLM_ENABLED=true
EDGE_VLM_MODEL=qwen2.5vl:7b
EDGE_VLM_BASE_URL=http://localhost:11434
EDGE_VLM_TIMEOUT_S=30

### Local runtime (optional)
# 本地 Java 安装目录；Neo4j 本地启动脚本可能会读取该变量，留空表示自动探测。
JAVA_HOME=

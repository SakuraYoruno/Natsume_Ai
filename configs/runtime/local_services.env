# Local dependency runtime profile (dev)
# This file contains non-secret runtime routing and secret references only.

NATSUME_ENV=dev

# Host and edge refs resolved via key profiles + secret store
OPENAI_API_KEY_REF=sec://openai/natsu-node-01
EDGE_HMAC_SHARED_KEY_REF=sec://edge/natsu-node-06

# Neo4j
BOND_NEO4J_ENABLED=true
BOND_NEO4J_URI=bolt://127.0.0.1:7687
BOND_NEO4J_DATABASE=neo4j
BOND_NEO4J_AUTH_REF=sec://neo4j/local-default
BOND_NEO4J_POOL_SIZE=50
BOND_NEO4J_TLS_ENABLED=false

# Chroma
CHROMA_ENABLED=true
CHROMA_ENDPOINT=http://127.0.0.1:8000
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
CHROMA_DEFAULT_COLLECTION=episodic
CHROMA_COLLECTION_PROFILES_JSON={"episodic":384,"canon":384}

# Retrieval model routing (local default)
RETR_EMBED_ENABLED=true
RETR_EMBED_DEFAULT_ROUTE=host_default
RETR_EMBED_ROUTES_JSON={"host_default":{"provider":"sentence_transformers","model_id":"sentence-transformers/all-MiniLM-L6-v2","dim":384,"timeout_ms":20000,"node_selector":"default,natsu-node-01"},"gpu_route":{"provider":"openai","model_id":"text-embedding-3-large","dim":3072,"timeout_ms":8000,"node_selector":"natsu-node-04,natsu-node-09"}}
RETR_EMBED_DEVICE=cpu
RETR_RERANK_ENABLED=true
RETR_RERANK_DEFAULT_ROUTE=host_default
RETR_RERANK_ROUTES_JSON={"host_default":{"provider":"cross_encoder","model_id":"BAAI/bge-reranker-base","top_k":5,"timeout_ms":90000,"node_selector":"default,natsu-node-01"},"gpu_route":{"provider":"cross_encoder","model_id":"BAAI/bge-reranker-large","top_k":3,"timeout_ms":120000,"node_selector":"natsu-node-04,natsu-node-09"}}
RETR_RERANK_DEVICE=cpu
RETR_RECALL_ENABLED=true
RETR_RECALL_DEFAULT_ROUTE=episodic_route
RETR_RECALL_ROUTES_JSON={"episodic_route":{"collection":"episodic","top_k":8,"score_weight":1.0,"node_selector":"default,natsu-node-01"},"canon_route":{"collection":"canon","top_k":4,"score_weight":0.75,"node_selector":"default,natsu-node-01"}}

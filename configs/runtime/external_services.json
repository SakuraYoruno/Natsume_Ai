{
  "schema_version": "1.0.0",
  "generated_on": "2026-03-02",
  "project": "Natsume_Ai",
  "notes": [
    "No secrets are stored in this file.",
    "Use *_REF fields and secret store files for credentials.",
    "Service defaults are extracted from runtime configs and startup scripts."
  ],
  "runtime_services": [
    {
      "service_id": "host.api",
      "name": "Host Brain FastAPI",
      "required": true,
      "owner": "host",
      "bind": {
        "host_env": "HOST_APP_HOST",
        "port_env": "HOST_APP_PORT",
        "default_host": "127.0.0.1",
        "default_port": 18080
      },
      "startup": {
        "script": "scripts/runtime/start_host_side.ps1",
        "command": "python -m host_brain --host ${HOST_APP_HOST} --port ${HOST_APP_PORT}"
      },
      "healthcheck": {
        "type": "http",
        "path": "/health",
        "url_template": "http://${HOST_APP_HOST}:${HOST_APP_PORT}/health"
      },
      "depends_on": [
        "neo4j",
        "chroma",
        "llm.providers",
        "retrieval.embedding",
        "retrieval.reranker",
        "edge.rpc.gateway"
      ],
      "config_sources": [
        ".env.example",
        "host_brain/__main__.py",
        "scripts/runtime/start_host_side.ps1"
      ]
    },
    {
      "service_id": "edge.rpc.gateway",
      "name": "Edge FastAPI RPC Gateway",
      "required": true,
      "owner": "edge",
      "bind": {
        "host_env": "EDGE_RPC_HOST",
        "port_env": "EDGE_RPC_PORT",
        "default_host": "127.0.0.1",
        "default_port": 17800
      },
      "startup": {
        "script": "scripts/runtime/start_edge_side.ps1",
        "command": "python -m edge_client"
      },
      "healthcheck": {
        "type": "http",
        "path": "/v1/edge/health",
        "url_template": "http://${EDGE_RPC_HOST}:${EDGE_RPC_PORT}/v1/edge/health"
      },
      "depends_on": [
        "edge.rpc.auth_key",
        "edge.asr.faster_whisper",
        "edge.tts.gpt_sovits",
        "edge.avatar.vtube_studio",
        "edge.fallback_llm.local"
      ],
      "config_sources": [
        ".env.example",
        "edge_client/config.py",
        "edge_client/__main__.py",
        "scripts/runtime/start_edge.ps1"
      ]
    }
  ],

# --- Global / OS ---
.DS_Store
Thumbs.db

# --- Skills Hub（外部安装的 skill，用户数据，不纳入版本管理）---
skills/
!skills/example-echo/

# --- Editors ---
.idea/
.vscode/

# --- Python cache / bytecode ---
__pycache__/
*.py[cod]
*.pyd
*.so

# --- Python tooling cache ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/
.tox/
.nox/

# --- Virtual envs ---
.venv/
venv/
env/
ENV/

# --- Node.js ---
node_modules/

# --- Build / package artifacts ---
build/
dist/
*.egg-info/
pip-wheel-metadata/

# --- Coverage / test reports ---
.coverage
.coverage.*
coverage.xml
htmlcov/
artifacts/trial_run_reports/*.json

# --- Temp / logs ---
*.log
*.tmp
*.temp
tmp/
temp/
.cache/
*.ast

# --- Secrets (keep templates) ---
.env
.env.*
!.env.example

# --- data/ runtime artifacts (never commit) ---
# JDK / Neo4j 安装包及解压目录
data/install/
data/jdk*/
data/neo4j*/
# Neo4j 运行时生成的 JSON / log
data/neo4j_install_info.json
data/neo4j_server.log
data/download_model.log
# ChromaDB 向量数据库运行时文件
data/chroma_db/
chroma_data/
# 其他数据库文件
data/*.db
data/*.sqlite3

# --- models/ 下载的模型文件 (never commit) ---
models/

# --- host_brain ---
# Runtime DB and state files
host_brain/data/
host_brain/data/*.db
host_brain/data/*.sqlite3

# Large local vector/model cache
host_brain/core/data/chroma_db/
host_brain/core/models/
*.bin
*.pth

# Runtime logs
host_brain/core/data/logs/
runtime_logs/

# --- edge_client ---
# Temporary audio generated during local runs
edge_client/temp_audio/
*.wav
*.mp3

# --- local runtime services ---
/runtime/
# Deprecated local env file (kept ignored for backward compatibility)
configs/runtime/local_services.env
configs/secrets/secret_store.runtime.local.json
configs/secrets/key_profiles.runtime.json

# --- local VTS / GPT-SoVITS runtime artifacts ---
.vts_token
GPT_SoVITS/
data/evidence/*.db

# --- Windows device file artifacts ---
nul
# pip 安装时产生的垃圾文件（如 =1.4.0）
=*

# --- 根目录临时调试 / 测试脚本（不属于正式测试套件）---
debug_intent.py
_check_health.py
test_fastapi_import.py
test_host_optimizations.py
test_real_env_integration.py
test_webui_integration.py

# --- flows 运行时导出产物 ---
flows/exports/

# --- release 构建产物 ---
/release/
!host_brain/release/
!host_brain/release/__init__.py
!host_brain/release/release_manifest.py

.codebuddy

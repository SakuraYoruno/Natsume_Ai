# ─────────────────────────────────────────────────────────────
# Natsume AI — OPTIONAL（可选第三方集成）
# OPTIMIZATION-PLAN-20260420 / OPT-4 §8.1
# ─────────────────────────────────────────────────────────────
# 说明：
#   - 本层包含可选依赖：LLM Provider、Edge RPC、Tribe 行为开关等。
#   - 不填时使用合理默认值（见 host_brain/app/settings/{llm,tribe}.py）。
#   - 启用具体 LLM Provider 前必须到对应服务商申请 API Key。

# ═════════════════════════════════════════════════════════════
# LLM Provider（host_brain/app/settings/llm.py · LLMSettings）
# ═════════════════════════════════════════════════════════════

# ─── Provider 选择 ─────────────────────────────────────────────
# 类型：枚举 openai | codex | gemini | deepseek | mock | disabled
# 默认：openai
# 说明：mock 为离线伪数据；disabled 则完全不走 LLM（仅规则链路）
HOST_LLM_PROVIDER=openai

# ─── LLM 调用超时 / 重试 ────────────────────────────────────────
# 类型：int ms / int
# 默认：15000 / 1
HOST_LLM_TIMEOUT_MS=15000
HOST_LLM_MAX_RETRIES=1

# ─── 冷启动策略 ─────────────────────────────────────────────────
# 类型：bool，默认 true
# 说明：true 时允许在无 API Key 情况下冷启动（部分功能会降级）。
HOST_COLD_START_ALLOWED=true

# ─── base_url 覆盖（走代理或私有部署时使用） ─────────────────────
# HOST_OPENAI_BASE_URL=https://api.openai.com/v1
# HOST_CODEX_BASE_URL=
# Gemini 走原生 langchain-google-genai 适配器，不再使用 OpenAI-compatible base URL。
# HOST_DEEPSEEK_BASE_URL=

# ─── 模型 ID 覆盖（不填则走 provider 默认模型） ─────────────────
# HOST_LLM_MODEL_ID=
# HOST_OPENAI_MODEL_ID=gpt-4o-mini
# HOST_GEMINI_MODEL_ID=gemini-2.5-pro
# HOST_DEEPSEEK_MODEL_ID=deepseek-v4-flash
# Normal chat 文本内核默认使用 DeepSeek；Gemini 只作为显式 A/B 或 fallback 试验。
# HOST_CHAT_KERNEL_V2_PROVIDER=deepseek
# HOST_CHAT_KERNEL_V2_MODEL_ID=deepseek-v4-flash
# prompt mode 默认走裸 Soul 极简内核；guided 仅用于 A/B 对照旧实验链。
# HOST_CHAT_KERNEL_V2_PROMPT_MODE=plain_soul
# semantic rerank 线上默认开启但非阻塞；只做候选优选，不阻塞质量门已通过的候选。
# HOST_CHAT_KERNEL_V2_SEMANTIC_RERANK_ENABLED=true
# StyleBank 默认关闭；只用于离线 A/B，避免台词参照把原作剧情事实带进日常回复。
# HOST_STYLE_REFERENCE_BANK_ENABLED=false
# Gateway 附件理解层使用的多模态模型（不直接生成用户可见回复）
# HOST_MULTIMODAL_PROVIDER=gemini
# HOST_MULTIMODAL_MODEL_ID_SYNC=gemini-2.5-flash-lite
# HOST_MULTIMODAL_MODEL_ID_ASYNC=gemini-2.5-pro
# HOST_MULTIMODAL_TIMEOUT_MS=15000
# HOST_MULTIMODAL_FILE_SYNC_MAX_BYTES=4194304
# HOST_MULTIMODAL_IMAGE_MAX_BYTES=4194304
# HOST_MULTIMODAL_VIDEO_MAX_DURATION_SECONDS=120
# HOST_MULTIMODAL_VIDEO_MAX_FRAMES=4

# ═════════════════════════════════════════════════════════════
# Edge RPC（host_brain/app/settings/tribe.py · TribeSettings）
# ═════════════════════════════════════════════════════════════

# ─── Edge RPC 基础连通 ─────────────────────────────────────────
# HOST_EDGE_RPC_BASE_URL=http://127.0.0.1:17800
# HOST_EDGE_RPC_SHARED_KEY=
HOST_EDGE_RPC_TIMEOUT_MS=3000
HOST_EDGE_RPC_RETRIES=1

# ─── 内部服务鉴权 ──────────────────────────────────────────────
# HOST_INTERNAL_TRIBE_TOKEN=

# ═════════════════════════════════════════════════════════════
# 行为开关（Tribe）
# ═════════════════════════════════════════════════════════════

# 类型：bool，默认均为 true
HOST_ENABLE_RETRIEVAL=true
HOST_ENABLE_VISION=true
HOST_ENABLE_EDGE_RPC=true

# ─── 系统模式 / 空闲阈值 ───────────────────────────────────────
# HOST_SYS_MODE=normal
# HOST_IDLE_THRESHOLD_MS=7200000

# ═════════════════════════════════════════════════════════════
# 可观测性告警阈值（OPT-3 SoftFailure）
# ═════════════════════════════════════════════════════════════
# 说明：SoftFailure 告警在 stage 维度触发：
#   当 SoftFailure 次数 / 总调用 ≥ ratio_threshold，且样本数 ≥ min_samples 时告警。
HOST_SOFT_FAIL_ALERT_RATIO_THRESHOLD=0.05
HOST_SOFT_FAIL_ALERT_MIN_SAMPLES=20

# ═════════════════════════════════════════════════════════════
# 心跳检查间隔
# ═════════════════════════════════════════════════════════════
HOST_SERVICE_HEALTH_HEARTBEAT_INTERVAL_S=30

from __future__ import annotations

from typing import Any

from host_brain.skills.declarative import DeclarativeSkillProvider, DeclarativeSkillSpec


def _normalize_echo(args: dict[str, Any], ctx: dict[str, Any] | None) -> dict[str, Any]:
    text = str((args or {}).get("text") or "").strip()
    return {
        "text": text,
        "session_id": str((ctx or {}).get("session_id") or "").strip() or None,
        "manifest_ref": f"custom_echo::{text[:40]}",
        "_context": ctx or {},
    }


class CustomEchoSkillProvider(DeclarativeSkillProvider):
    skill_specs = (
        DeclarativeSkillSpec(
            skill_name="custom_echo",
            clearance="LOW",
            risk_level=1,
            scope="host",
            reversible=True,
            description="示例自定义技能：返回传入文本。",
            tool="custom_echo",
            action="run",
            normalize_args=_normalize_echo,
        ),
    )


SKILL_PROVIDER_CLASS = CustomEchoSkillProvider

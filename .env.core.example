# ─────────────────────────────────────────────────────────────
# Natsume AI — CORE（核心必需，MVP 起步最小集合）
# OPTIMIZATION-PLAN-20260420 / OPT-4 §8.1
# ─────────────────────────────────────────────────────────────
# 说明：
#   - 本层是启动 host_brain 的**最小必需**环境变量。只要这些正确配置即可
#     冷启动一个可用的开发实例。
#   - 生产部署必须 override；其他可选域（LLM Provider、多平台网关）见
#     .env.optional.example。
#   - 实验性/灰度开关请看 .env.experimental.example。
#   - 该三层文件对应 host_brain/app/settings/core.py 的 CoreSettings，
#     以及 observability.py 中的 ObservabilitySettings 的核心心跳字段。

# ─── 运行环境标识 ───────────────────────────────────────────────
# 类型：枚举 dev | test | prod
# 默认：dev
# 说明：影响日志级别默认值、特性开关默认值。生产必填 prod。
Natsume_ENV=dev

# ─── 数据目录 ───────────────────────────────────────────────────
# 类型：path
# 默认：./data
# 说明：SQLite ledger、Chroma 向量库、Neo4j 运行时文件的根目录。
NATSUME_DATA_DIR=./data

# ─── 日志级别 ───────────────────────────────────────────────────
# 类型：枚举 DEBUG | INFO | WARN | WARNING | ERROR
# 默认：INFO
HOST_APP_LOG_LEVEL=INFO

# ─── Host HTTP 监听端点 ─────────────────────────────────────────
# 类型：host / port
# 默认：127.0.0.1 / 18080
HOST_APP_HOST=127.0.0.1
HOST_APP_PORT=18080

# ─── 监控代理（observability core） ─────────────────────────────
# 类型：bool / host / port
# 默认：true / 127.0.0.1 / 18180
HOST_MONITOR_PROXY_ENABLED=true
HOST_MONITOR_PROXY_HOST=127.0.0.1
HOST_MONITOR_PROXY_PORT=18180

### 1) 环境标识
# 主环境标识；可选 dev/test/prod，影响鉴权策略、冷启动策略和部分默认开关。
Natsume_ENV=dev

### 2) Host HTTP 服务
# Host HTTP 服务监听地址；本机开发通常使用 127.0.0.1。
HOST_APP_HOST=127.0.0.1
# Host HTTP 服务端口；默认 18080。
HOST_APP_PORT=18080
# Host 日志级别；常用 DEBUG/INFO/WARN/WARNING/ERROR。
HOST_APP_LOG_LEVEL=INFO

### 3) 数据目录
# 持久化数据根目录（SQLite/Chroma 本地数据）。
NATSUME_DATA_DIR=./data

### 4) LLM 基础
# Host 主 LLM 提供商；可选 openai/codex/gemini/deepseek/mock/disabled。
HOST_LLM_PROVIDER=openai
# Host 调用 LLM 的单次超时时间（毫秒）。
HOST_LLM_TIMEOUT_MS=15000
# Host 调用 LLM 的最大重试次数；0 表示不重试。
HOST_LLM_MAX_RETRIES=1
# 冷启动是否允许在缺失可用 LLM 密钥时继续启动。
HOST_COLD_START_ALLOWED=true

### 5) 能力开关
# 是否启用检索链路（Recall/Embedding/Reranker）。
HOST_ENABLE_RETRIEVAL=true
# 是否启用视觉能力。
HOST_ENABLE_VISION=true
# 是否启用 Host 与 Edge 的 RPC 交互。
HOST_ENABLE_EDGE_RPC=true

### 6) 可观测性（最小心跳 + 告警阈值）
# 服务健康心跳间隔（秒）。
HOST_SERVICE_HEALTH_HEARTBEAT_INTERVAL_S=30
# SoftFailure（OPT-3）告警比例阈值：某 stage 连续 N 次调用中失败比例 > 该值触发告警。
HOST_SOFT_FAIL_ALERT_RATIO_THRESHOLD=0.05
# SoftFailure 告警最小样本量（防止抖动）。
HOST_SOFT_FAIL_ALERT_MIN_SAMPLES=20

### 完成以上字段后即可启动；更多可选配置请参考 .env.example。

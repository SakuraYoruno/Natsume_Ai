# ─────────────────────────────────────────────────────────────
# Natsume AI — EXPERIMENTAL（灰度 / Feature Flag）
# OPTIMIZATION-PLAN-20260420 / OPT-4 §8.1
# ─────────────────────────────────────────────────────────────
# 说明：
#   - 本层是**可能不稳定**或**尚在灰度**的开关；默认均关闭。
#   - 开启前请阅读对应的 docs/35_quality/*.md 设计文档。
#   - 生产部署请谨慎启用。

# OPT-3 · SoftFailure 基建
# ═════════════════════════════════════════════════════════════
# 说明：新 soft_fail 基建一律默认启用（见 host_brain/core/soft_fail.py）。
#   若出现异常降噪需求，可在此层临时禁用某个 stage 的日志（通过
#   logging config 实现；非 env 键）。当前无直接 env 开关。

# ═════════════════════════════════════════════════════════════
# NE-01 · Durable Graph cancellation / Operation / terminal 对账
# ═════════════════════════════════════════════════════════════
# 四个 Operator 入口均默认关闭。开启 Graph cancellation 时，Operation 与
# Effect reconciliation 必须同时开启；Operator 入口都要求 Secure
# Ingress=ENFORCE、可执行 Gateway 和只含公钥的 Ed25519 keyring。
HOST_TASK_GRAPH_CANCELLATION_OPERATOR_ENABLED=false
HOST_TASK_OPERATION_RECONCILIATION_OPERATOR_ENABLED=false
HOST_TASK_EFFECT_RECONCILIATION_OPERATOR_ENABLED=false
HOST_TASK_TERMINAL_RECONCILIATION_OPERATOR_ENABLED=false
# 仅处理 0099 EXACT_REPAIRABLE，仍需显式 opt-in。
HOST_TASK_TERMINAL_RECONCILIATION_AUTO_ENABLED=false
HOST_TASK_RECONCILIATION_ED25519_PUBLIC_KEYS_JSON=

# 说明：
#   - 本层是**可能不稳定**或**尚在灰度**的开关；默认均关闭。
#   - 开启前请阅读对应的 docs/35_quality/*.md 设计文档。
#   - 生产部署请谨慎启用。

# ═════════════════════════════════════════════════════════════
# OPT-3 · SoftFailure 基建
# ═════════════════════════════════════════════════════════════
# 说明：新 soft_fail 基建一律默认启用（见 host_brain/core/soft_fail.py）。
#   若出现异常降噪需求，可在此层临时禁用某个 stage 的日志（通过
#   logging config 实现；非 env 键）。当前无直接 env 开关。

# ═════════════════════════════════════════════════════════════
# OPT-6 · Prompts YAML Lint（二期：变量交叉比对）
# ═════════════════════════════════════════════════════════════
# 说明：二期 lint 会在 PR 流水线中比对 .format_map() 调用点传入变量与
# prompts/templates/**.yaml 占位符声明；误报率待观察，先灰度。
#
# 类型：bool，默认 false
NATSUME_PROMPT_LINT_STRICT_CROSSCHECK=false

# ═════════════════════════════════════════════════════════════
# OPT-7 · chat_agent / prompt_builder 拆分（二期）
# ═════════════════════════════════════════════════════════════
# 说明：二期会把 chat_agent.py 主体拆为 ≤ 400 行的协调器 + 多个 stage
# 子模块。迁移期间需要保留两套入口，通过 env 切换。
#
# 类型：bool，默认 false
NATSUME_CHAT_AGENT_V2_PIPELINE=false

# ═════════════════════════════════════════════════════════════
# OPT-8 · Edge ChatChannel Protocol 迁移
# ═════════════════════════════════════════════════════════════
# 说明：把现有平台 adapter 切换为 edge_client/channels/base.py 的 Protocol
# 实现。迁移一个平台灰度一个。
#
# 类型：bool，默认 false
NATSUME_EDGE_CHANNEL_PROTOCOL_WECHAT=false
NATSUME_EDGE_CHANNEL_PROTOCOL_TELEGRAM=false
NATSUME_EDGE_CHANNEL_PROTOCOL_QQ=false
NATSUME_EDGE_CHANNEL_PROTOCOL_FEISHU=false
NATSUME_EDGE_CHANNEL_PROTOCOL_WECOM=false
NATSUME_EDGE_CHANNEL_PROTOCOL_LINE=false

# ═════════════════════════════════════════════════════════════
# OPT-9 · ObsQueryBuilder 迁移
# ═════════════════════════════════════════════════════════════
# 说明：把 obs_routes_*.py 里的原生 SQL 逐步迁入 host_brain/observability/
# queries/*.yaml。开关用于逐个 route 灰度切换到 query_builder.run_named。
#
# 类型：bool，默认 false
NATSUME_OBS_USE_QUERY_BUILDER_SESSION_SUMMARY=false

# ═════════════════════════════════════════════════════════════
# OPT-10 · agent_runtime_shared 拆分
# ═════════════════════════════════════════════════════════════
# 说明：拆分后需要验证旧路径 import 全部被 re-export 保留；灰度期保留
# 老路径兜底。
#
# 类型：bool，默认 false
NATSUME_AGENT_RUNTIME_SHARED_V2_LAYOUT=false

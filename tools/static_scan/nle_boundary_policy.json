{
  "schema_version": 1,
  "policy_id": "TASK-0464_NLE_BOUNDARY_DOMAIN_CUTOVER",
  "rules": [
    {
      "rule_id": "NLE-BND-EDGE-HOST-IMPL",
      "kind": "module_import",
      "source_roots": ["edge_client"],
      "forbidden_module_prefixes": ["host_brain.app", "host_brain.audit"],
      "module_scope_only": true
    },
    {
      "rule_id": "NLE-BND-AGENTRUNTIME-APP",
      "kind": "module_import",
      "source_roots": ["host_brain/agent_runtime"],
      "forbidden_module_prefixes": ["host_brain.app"],
      "module_scope_only": true
    },
    {
      "rule_id": "NLE-BND-PENTEST-WORLDCANON-IMPORT",
      "kind": "import",
      "source_roots": ["host_brain/pentest"],
      "forbidden_module_prefixes": ["host_brain.memory.canon_world_store"],
      "module_scope_only": false
    },
    {
      "rule_id": "NLE-BND-PENTEST-WORLDCANON-UPSERT",
      "kind": "call_attribute",
      "source_roots": ["host_brain/pentest"],
      "attributes": ["upsert_document"]
    },
    {
      "rule_id": "NLE-BND-PENTEST-CANON-VECTOR-READER",
      "kind": "call_name",
      "source_roots": ["host_brain/pentest"],
      "names": ["CanonVectorQuery"]
    },
    {
      "rule_id": "NLE-BND-NO-PARALLEL-LIFE-ROOT",
      "kind": "forbidden_path",
      "paths": ["host_brain/life"]
    }
  ],
  "allowlist": [
    {
      "rule_id": "NLE-BND-EDGE-HOST-IMPL",
      "path": "edge_client/rpc/fallback_llm.py",
      "symbol": "host_brain.audit.sqlite_ledger.SQLiteLedger",
      "owner": "EDGE_RUNTIME",
      "reason": "Existing Edge fallback audit coupling captured by TASK-0461.",
      "remove_task": "M55_EDGE_RUNTIME"
    },
    {
      "rule_id": "NLE-BND-EDGE-HOST-IMPL",
      "path": "edge_client/rpc/resource_gate.py",
      "symbol": "host_brain.audit.sqlite_ledger.SQLiteLedger",
      "owner": "EDGE_RUNTIME",
      "reason": "Existing Edge resource-gate audit coupling captured by TASK-0461.",
      "remove_task": "M55_EDGE_RUNTIME"
    },
    {
      "rule_id": "NLE-BND-EDGE-HOST-IMPL",
      "path": "edge_client/rpc/voice.py",
      "symbol": "host_brain.audit.sqlite_ledger.SQLiteLedger",
      "owner": "EDGE_RUNTIME",
      "reason": "Existing Edge voice audit coupling captured by TASK-0461.",
      "remove_task": "M55_EDGE_RUNTIME"
    },
    {
      "rule_id": "NLE-BND-AGENTRUNTIME-APP",
      "path": "host_brain/agent_runtime/agent_tools.py",
      "symbol": "host_brain.app.agents.tool_registry.ToolSpec",
      "owner": "AGENT_RUNTIME",
      "reason": "Existing module-level ToolSpec dependency captured by TASK-0461.",
      "remove_task": "M50_AGENT_RUNTIME"
    }
  ]
}

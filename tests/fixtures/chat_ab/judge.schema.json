{
  "type": "object",
  "additionalProperties": false,
  "required": ["judgements"],
  "properties": {
    "judgements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "winner", "confidence", "scores", "hard_failures", "reason"],
        "properties": {
          "case_id": { "type": "string" },
          "winner": { "type": "string" },
          "confidence": { "type": "number" },
          "scores": {
            "type": "object",
            "additionalProperties": false,
            "required": ["current", "baseline_soul"],
            "properties": {
              "current": { "$ref": "#/$defs/score" },
              "baseline_soul": { "$ref": "#/$defs/score" }
            }
          },
          "hard_failures": {
            "type": "object",
            "additionalProperties": false,
            "required": ["current", "baseline_soul"],
            "properties": {
              "current": { "type": "array", "items": { "type": "string" } },
              "baseline_soul": { "type": "array", "items": { "type": "string" } }
            }
          },
          "reason": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "soul_fit",
        "galgame_line_energy",
        "sibling_interaction",
        "emotional_authenticity",
        "sora_distinctiveness",
        "service_tone_avoidance",
        "naturalness",
        "context_coherence",
        "input_understanding",
        "non_regression"
      ],
      "properties": {
        "soul_fit": { "type": "integer" },
        "galgame_line_energy": { "type": "integer" },
        "sibling_interaction": { "type": "integer" },
        "emotional_authenticity": { "type": "integer" },
        "sora_distinctiveness": { "type": "integer" },
        "service_tone_avoidance": { "type": "integer" },
        "naturalness": { "type": "integer" },
        "context_coherence": { "type": "integer" },
        "input_understanding": { "type": "integer" },
        "non_regression": { "type": "integer" }
      }
    }
  }
}

{
    "description":  "ASR 麦克风设备断开→恢复全部耗尽 fixture",
    "scenario":  "asr_device_recovery_exhausted",
    "initial_state":  {
                          "asr_state":  "STREAMING",
                          "device_index":  0,
                          "session_id":  "asr_test_002"
                      },
    "trigger":  {
                    "event":  "ASR_DEVICE_ERROR",
                    "reason":  "driver_crash",
                    "ts_ms":  1709308800000
                },

{
  "description": "ASR 麦克风设备断开→自动恢复成功 fixture",
  "scenario": "asr_device_recovery_success",
  "initial_state": {
    "asr_state": "STREAMING",
    "device_index": 0,
    "session_id": "asr_test_001"
  },
  "trigger": {
    "event": "ASR_DEVICE_ERROR",
    "reason": "device_disconnected",
    "ts_ms": 1709308800000
  },
  "recovery_config": {

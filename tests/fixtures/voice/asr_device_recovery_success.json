  },
  "mock_failures_before_success": 2,
  "expected": {
    "final_state": "READY",
    "recovery_event": "ASR_DEVICE_RECOVERED",
    "recovery_attempts": 3,
    "running": true,
    "audit_event": {
      "event": "ASR_DEVICE_RECOVERED",
      "attempt": 3,
      "detail": "device recovered after 3 attempt(s) on original_device_0"
